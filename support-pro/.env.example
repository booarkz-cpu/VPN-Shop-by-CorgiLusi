COMPOSE_PROJECT_NAME=support-pro-2
POSTGRES_DB=support
POSTGRES_USER=support
POSTGRES_PASSWORD=
SESSION_SECRET=
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
BOT_TOKEN=
DOMAIN=
LETSENCRYPT_EMAIL=
PUBLIC_ORIGIN=
COOKIE_SECURE=true
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=50
# Optional provider supporting POST {AI_BASE_URL}/chat/completions.
# The URL must use HTTPS and include the API version prefix, e.g. /v1.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 3.4: permitted webhook hosts, comma-separated; HTTPS required
WEBHOOK_ALLOWED_HOSTS=
# Enable docker compose --profile antivirus up -d; then set host and enforce scanning.
CLAMAV_HOST=
CLAMAV_PORT=3310
REQUIRE_ANTIVIRUS=false

# Optional strong bearer token for a metrics collector. Empty: administrator session only.
METRICS_TOKEN=

SSO_SECRET=
PUBLIC_ORIGIN=
