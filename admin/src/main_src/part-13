function OrchestratorDesk({d,reload,toast}:any){const[cfg,setCfg]=useState<any>(d||{});useEffect(()=>setCfg(d||{}),[d]);async function save(){await req('/api/admin/v6/config/orchestrator',{method:'PUT',body:JSON.stringify({value:cfg})});toast('Orchestrator сохранён');reload()}async function run(){const r=await req('/api/admin/v6/orchestrator/evaluate',{method:'POST'});toast(`Создано действий: ${r.actions?.length||0}`)}return <div className="grid2"><div className="card"><h3>Node Orchestrator</h3><label className="check"><input type="checkbox" checked={!!cfg.auto_heal} onChange={e=>setCfg({...cfg,auto_heal:e.target.checked})}/> Auto-Healing</label><label className="check"><input type="checkbox" checked={!!cfg.approval_required} onChange={e=>setCfg({...cfg,approval_required:e.target.checked})}/> Approval для drain/recovery</label><label>Stale timeout<input type="number" value={cfg.stale_seconds||180} onChange={e=>setCfg({...cfg,stale_seconds:+e.target.value})}/></label><button className="primary" onClick={save}>Сохранить</button><button onClick={run}>Оценить инфраструктуру</button></div><div className="card"><h3>Безопасное выполнение</h3><p className="muted">Без credentials облачного провайдера orchestrator создаёт только проверяемые intents/actions. Разрушительные действия не симулируются.</p></div></div>}
function CommercialDesk({d}:any){return <div className="stats"><Stat title="MRR proxy / 30d" value={d?.mrr_proxy||0} icon="€"/><Stat title="ARPU 30d" value={d?.arpu_30d||0} icon="◈"/><Stat title="Активные" value={d?.active||0} icon="◉"/><Stat title="Промокоды" value={d?.coupons||0} icon="%"/></div>}
function IntegrationsDesk({d}:any){return <div className="grid2"><Table title="Public API keys" cols={['Имя','Prefix','Scopes','Enabled','Last used']} rows={(d?.api_keys||[]).map((x:any)=>[x.name,x.prefix,x.scopes,x.enabled?'да':'нет',x.last_used_at||'—'])}/><Table title="Webhooks" cols={['URL','Events','Enabled','Status']} rows={(d?.webhooks||[]).map((x:any)=>[x.url,x.events,x.enabled?'да':'нет',x.last_status||'—'])}/></div>}
function EventsDesk({d}:any){return <Table title="Event Bus" cols={['Время','Событие','Actor','Target','Request ID']} rows={(d||[]).map((x:any)=>[x.created_at,x.event,x.actor,x.target||'—',x.request_id])}/>}
function SocDesk({d}:any){return <div className="grid2"><Table title="Security incidents" cols={['ID','Тип','Severity','Status']} rows={(d?.incidents||[]).map((x:any)=>[x.id,x.kind,x.severity,x.status])}/><Table title="Fraud signals" cols={['ID','Тип','Score','User','Status']} rows={(d?.fraud||[]).map((x:any)=>[x.id,x.kind,x.score,x.user_id||'—',x.status])}/></div>}
function IntelligenceDesk({d}:any){return <div className="card"><h3>Corgi Intelligence</h3><p className="muted">Рекомендации строятся детерминированно на фактических сигналах системы; опасные действия не выполняются автоматически.</p>{(d?.recommendations||[]).map((x:any,i:number)=><div className="alert" key={i}><b>{x.priority}</b> · {x.title} <small>({x.source})</small></div>)}</div>}
