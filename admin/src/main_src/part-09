 <div className="card"><h3>Mini App</h3><label>Заголовок<input value={mini.title||''} onChange={e=>setMini({...mini,title:e.target.value})}/></label><label>Подзаголовок<input value={mini.subtitle||''} onChange={e=>setMini({...mini,subtitle:e.target.value})}/></label><label>Цвет фона<input value={mini.background_color||''} onChange={e=>setMini({...mini,background_color:e.target.value})}/></label><label>Инструкция<textarea rows={8} value={mini.instructions||''} onChange={e=>setMini({...mini,instructions:e.target.value})}/></label><h3>Кнопки Mini App</h3>{(mini.buttons||[]).map((b:any,i:number)=><div className="inline" key={i}><input placeholder="Текст" value={b.title||''} onChange={e=>{const a=[...(mini.buttons||[])];a[i]={...b,title:e.target.value};setMini({...mini,buttons:a})}}/><select value={b.type||'plans'} onChange={e=>{const a=[...(mini.buttons||[])];a[i]={...b,type:e.target.value};setMini({...mini,buttons:a})}}><option value="plans">Тарифы</option><option value="promo">Промокод</option><option value="url">URL</option><option value="field">Поле</option></select><input placeholder="URL / field_key" value={b.url||b.field_key||''} onChange={e=>{const a=[...(mini.buttons||[])];a[i]={...b,...(b.type==='url'?{url:e.target.value}:{field_key:e.target.value})};setMini({...mini,buttons:a})}}/><button onClick={()=>setMini({...mini,buttons:(mini.buttons||[]).filter((_:any,j:number)=>j!==i)})}>×</button></div>)}<button onClick={()=>setMini({...mini,buttons:[...(mini.buttons||[]),{title:'Новая кнопка',type:'plans'}]})}>+ Кнопка</button><button className="primary" onClick={saveMini}>Сохранить Mini App</button><label>Главное изображение Mini App<input type="file" accept="image/png,image/jpeg,image/webp" onChange={e=>(window as any).__miniImage=e.target.files?.[0]||null}/></label><button onClick={async()=>{const f=(window as any).__miniImage;if(!f)return;const fd=new FormData();fd.append('file',f);await req('/api/admin/miniapp/image',{method:'POST',body:fd});toast('Изображение Mini App сохранено');reload()}}>Установить главное изображение</button>{s.miniapp_image&&<><img src={API+s.miniapp_image} style={{width:160,maxHeight:160,objectFit:'cover',borderRadius:12}}/><button onClick={async()=>{await req('/api/admin/miniapp/image',{method:'DELETE'});reload()}}>Удалить главное изображение</button></>}<label>Фон Mini App<input type="file" accept="image/png,image/jpeg,image/webp" onChange={e=>setBgFile(e.target.files?.[0]||null)}/></label><button onClick={uploadBg}>Загрузить фон</button><button onClick={async()=>{await req('/api/admin/miniapp/background',{method:'DELETE'});reload()}}>Удалить фон</button><h3>Пользовательские поля</h3>{f.map((x:any)=><div className="inline" key={x.id}><input value={x.label} onChange={e=>setF(f.map((q:any)=>q.id===x.id?{...q,label:e.target.value}:q))}/><button onClick={async()=>{await req(`/api/admin/fields/${x.id}`,{method:'PUT',body:JSON.stringify(x)});reload()}}>Сохранить</button><button onClick={async()=>{await req(`/api/admin/fields/${x.id}`,{method:'DELETE'});reload()}}>×</button></div>)}<div className="form-grid"><input placeholder="key" value={fieldNew.key} onChange={e=>setFieldNew({...fieldNew,key:e.target.value})}/><input placeholder="Название" value={fieldNew.label} onChange={e=>setFieldNew({...fieldNew,label:e.target.value})}/><textarea placeholder="Content" value={fieldNew.value} onChange={e=>setFieldNew({...fieldNew,value:e.target.value})}/><button onClick={addField}>Добавить поле</button></div></div></div>
}
function Marketing({d,reload,toast}:any){const[code,setCode]=useState('');const[disc,setDisc]=useState('10');const[ad,setAd]=useState('');const[promo,setPromo]=useState('');const[promoDisc,setPromoDisc]=useState('10');const[btext,setBtext]=useState('');const[btarget,setBtarget]=useState('all');const[bbutton,setBbutton]=useState('');const[burl,setBurl]=useState('');const[bimage,setBimage]=useState('');async function addPromo(){await req('/api/admin/promo-codes',{method:'POST',body:JSON.stringify({code,kind:'percent',value:Number(disc),enabled:true})});setCode('');toast('Промокод создан');reload()}async function addPromotion(){await req('/api/admin/promotions',{method:'POST',body:JSON.stringify({name:promo,kind:'percent',value:Number(promoDisc),enabled:true,description:`Скидка ${promoDisc}%`})});setPromo('');toast('Акция создана');reload()}async function addAd(){await req('/api/admin/advertisements',{method:'POST',body:JSON.stringify({title:ad,text:'',enabled:true,sort_order:0})});setAd('');toast('Реклама создана');reload()}async function addBroadcast(){if(!btext.trim())return;await req('/api/admin/broadcasts',{method:'POST',body:JSON.stringify({text:btext,target:btarget,button_text:bbutton||null,button_url:burl||null,image_url:bimage||null})});setBtext('');toast('Рассылка поставлена в очередь');reload()}async function retryBroadcast(id:number){await req('/api/admin/broadcasts/'+id+'/retry',{method:'POST',body:'{}'});toast('Рассылка возвращена в очередь');reload()}return <div className="grid2"><div className="card"><h3>Акции</h3><div className="inline"><input placeholder="Название акции" value={promo} onChange={e=>setPromo(e.target.value)}/><input type="number" value={promoDisc} onChange={e=>setPromoDisc(e.target.value)}/><button className="primary" onClick={addPromotion}>Создать</button></div><Table title="Акции" cols={['Название','Скидка','Приоритет','Статус']} rows={(d?.promotions||[]).map((x:any)=>[x.name,`${x.value}${x.kind==='percent'?'%':' ₽'}`,x.priority,x.enabled?'ВКЛ':'ВЫКЛ'])}/><h3>Промокоды</h3><div className="inline"><input placeholder="CODE" value={code} onChange={e=>setCode(e.target.value.toUpperCase())}/><input type="number" value={disc} onChange={e=>setDisc(e.target.value)}/><button className="primary" onClick={addPromo}>Создать</button></div><Table title="Коды" cols={['Код','Скидка','Использовано','Лимит']} rows={(d?.promo_codes||[]).map((x:any)=>[x.code,`${x.value}${x.kind==='percent'?'%':' ₽'}`,x.used_count,x.usage_limit||'∞'])}/></div><div className="card"><h3>Реклама</h3><div className="inline"><input placeholder="Заголовок" value={ad} onChange={e=>setAd(e.target.value)}/><button className="primary" onClick={addAd}>Создать</button></div><Table title="Блоки" cols={['Заголовок','Статус','Порядок']} rows={(d?.advertisements||[]).map((x:any)=>[x.title,x.enabled?'ВКЛ':'ВЫКЛ',x.sort_order])}/><h3>Рассылки</h3><p className="muted">Очередь уходит в Telegram-бот. Получатели — пользователи с Telegram ID. Повтор продолжает с сохранённого счётчика и не начинает список заново.</p><select aria-label="Аудитория рассылки" value={btarget} onChange={e=>setBtarget(e.target.value)}><option value="all">Все с Telegram</option><option value="active">Активная подписка</option><option value="inactive">Без активной подписки</option></select><textarea rows={5} placeholder="Текст HTML-рассылки" value={btext} onChange={e=>setBtext(e.target.value)}/><input placeholder="Текст кнопки" value={bbutton} onChange={e=>setBbutton(e.target.value)}/><input placeholder="HTTPS URL кнопки" value={burl} onChange={e=>setBurl(e.target.value)}/><input placeholder="HTTPS URL изображения" value={bimage} onChange={e=>setBimage(e.target.value)}/><button className="primary" onClick={addBroadcast}>Отправить в очередь</button><Table title="История" cols={['Аудитория рассылки','Статус','Отправлено','Ошибок','Действие']} rows={(d?.broadcasts||[]).map((x:any)=>[x.target==='active'?'Активные':x.target==='inactive'?'Неактивные':'Все с Telegram',x.status,x.sent_count,x.failed_count,(x.status==='sending'||x.status==='failed')?<button onClick={()=>retryBroadcast(x.id)}>Повторить</button>:'—'])}/></div></div>}
