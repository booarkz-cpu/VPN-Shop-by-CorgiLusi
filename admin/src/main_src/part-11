function FinancialLedger({d}:any){return <div className="card"><h3>Финансовый журнал</h3><p className="muted">Неизменяемый журнал подтверждённых платежей и возвратов. Повторная операция не создаёт вторую запись.</p><Table title="Операции" cols={['ID','Операция','Пользователь','Платёж','Тип','Направление','Сумма','Валюта','Время']} rows={(d||[]).map((x:any)=>[x.id,x.operation_key,x.user_id||'—',x.payment_id||'—',ru(x.kind),ru(x.direction),x.amount,x.currency,x.created_at])}/></div>}

function Table({title,cols,rows}:any){return <div className="card table-card"><div className="table-head"><h3>{title}</h3><span>{rows.length} записей</span></div><div className="table-wrap"><table><thead><tr>{cols.map((c:string)=><th key={c}>{c}</th>)}</tr></thead><tbody>{rows.map((r:any[],i:number)=><tr key={i}>{r.map((v:any,j:number)=><td key={j}>{v}</td>)}</tr>)}</tbody></table></div></div>}
function Row({k,v}:any){return <div className="security-row"><span>{k}</span><b>{v}</b></div>}
createRoot(document.getElementById('root')!).render(<LangProvider><App/></LangProvider>);

function SupportProDesk({d,toast}:any){
 const[loading,setLoading]=useState(false); const[url,setUrl]=useState("");
 async function open(){setLoading(true);try{const r=await req("/api/admin/support-pro/sso",{method:"POST",body:JSON.stringify({})});setUrl(r.url);toast("Support Pro открыт через защищённый SSO")}catch(e:any){toast(e.message)}finally{setLoading(false)}}
 return <div className="support-pro-wrap"><div className="hero"><div><div className="eyebrow">SUPPORT PRO · ЕДИНЫЙ КОНТУР</div><h2>Центр поддержки встроен в VPN Shop by Corgi.</h2><p>Тикеты, SLA, Telegram, база знаний, автоматизация, операторы, инциденты, webhooks и realtime работают в отдельном изолированном сервисе, а вход выполняется через короткоживущий SSO.</p></div><div className="hero-glow">◒</div></div><div className="grid2"><div className="card"><h3>Состояние Support Pro</h3><Row k="Настроен" v={d?.configured?"Да":"Нет"}/><Row k="Онлайн" v={d?.online?"● Online":"○ Offline"}/><Row k="HTTP" v={d?.status_code||"—"}/><Row k="URL" v={d?.url||"SUPPORT_PRO_URL не задан"}/>{d?.error&&<p className="error">{d.error}</p>}<button className="primary" disabled={loading||!d?.online} onClick={open}>{loading?"Создание SSO…":"Открыть Support Pro"}</button></div><div className="card"><h3>Что доступно</h3><div className="chips"><span>Tickets</span><span>SLA</span><span>Telegram</span><span>Knowledge Base</span><span>Macros</span><span>Automation</span><span>Webhooks</span><span>Incidents</span><span>Reports</span><span>Realtime</span></div><p className="muted">SSO-токен действует 60 секунд и одноразово поглощается Support Pro. Секрет SSO не передаётся в браузер.</p></div></div>{url&&<div className="card support-pro-frame"><div className="toolbar"><h3>Support Pro</h3><button onClick={()=>setUrl("")}>Закрыть</button></div><iframe title="Support Pro" src={url} style={{width:"100%",height:"78vh",border:0,borderRadius:16,background:"#0b0f16"}} /></div>}</div>}

function Refunds({d,reload}:any){return <div className="card"><h3>Возвраты</h3><Table title="Центр возвратов" cols={['ID','Платёж','User','Сумма','Статус','Действия']} rows={(d||[]).map((x:any)=>[x.id,x.payment_id,x.user_id,`${x.amount}`,ru(x.status),x.status!=='refunded'&&<button onClick={async()=>{await req(`/api/admin/refunds/${x.id}/approve`,{method:'POST'});reload()}}>Одобрить</button>])}/></div>}
function Workers({d,reload}:any){return <div className="card"><h3>Система рабочих процессов</h3><Table title="Рабочие процессы" cols={['Рабочий процесс','Роль','Статус','Задача','Последняя активность']} rows={(d||[]).map((x:any)=>[x.worker_id,x.role,x.status,x.current_job||'—',x.last_seen_at])}/><button onClick={reload}>Обновить</button></div>}
function Releases({d}:any){const[git,setGit]=useState<any>(null);const[err,setErr]=useState("");useEffect(()=>{req("/api/admin/github-update").then(setGit).catch((e:any)=>setErr(e.message||"GitHub не ответил"))},[]);return <div className="card"><h3>Обновление / откат</h3><p>Текущая версия: <b>корпоративный контур</b></p><h3>Релиз GitHub</h3>{err?<p className="muted">{err}</p>:null}{git?<div><p><span>Репозиторий</span>: {git.repository}</p><p><span>Установлено</span>: {git.current}</p><p><span>На GitHub</span>: {git.latest||"—"}</p><p>{git.update_available?<span>Обновление доступно</span>:<span>Актуальная версия</span>}</p><p className="muted"><span>Команда на сервере</span>: <code>{git.apply_command}</code></p></div>:null}<p className="muted">Панель показывает статус. Архив применяет скрипт на хосте: он сверяет SHA-256, сохраняет .env и запускает scripts/update.sh.</p><Table title="История релизов" cols={['Версия','Статус','Откат','Дата']} rows={(d||[]).map((x:any)=>[x.version,x.status,x.rollback_archive||'—',x.created_at])}/><p className="muted">Обновление выполняется через scripts/update.sh с pre-update snapshot и health-check.</p></div>}

function Recovery({d,reload,toast}:any){return <div className="grid2"><div className="card"><h3>Центр восстановления</h3><Row k="Технический режим" v={d?.maintenance_mode?"ВКЛ":"ВЫКЛ"}/><Row k="Состояние восстановления" v={d?.restore_state||"ok"}/><Row k="Рабочий процесс heartbeat" v={d?.worker_heartbeat||"MISSING"}/><Row k="Критические ошибки выдачи" v={d?.terminal_fulfillment_failures||0}/>{d?.recovery_required&&<div className="error">Требуется ручная проверка. Maintenance/restore mode не снимается автоматически после неуспешного restore.</div>}<button onClick={reload}>Обновить</button></div><div className="card"><h3>Аварийный режим</h3><Row k="Статус" v={d?.incident_mode?"ВКЛ":"ВЫКЛ"}/><button className="danger" onClick={async()=>{await req("/api/admin/incident-mode",{method:"POST",body:JSON.stringify({enabled:true})});toast("Аварийный режим включён");reload()}}>Включить</button><button onClick={async()=>{await req("/api/admin/incident-mode",{method:"POST",body:JSON.stringify({enabled:false})});toast("Аварийный режим выключен");reload()}}>Выключить</button><h3>Реестр рефералов</h3><button onClick={async()=>{const r=await req("/api/admin/referrals/reconcile",{method:"POST"});toast(`Сверено: ${r.checked}, исправлено: ${r.changed}`)}}>Сверить баланс</button></div></div>}
// V40 release marker

function Monitoring({d,reload}:any){return <div className="grid2"><div className="card"><h3>Центр мониторинга</h3><Row k="Версия" v={d?.version||'—'}/><Row k="Диск" v={`${d?.disk_percent??'—'}%`}/><Row k="Запросы" v={d?.requests?.requests_total??0}/><Row k="Ошибки" v={d?.requests?.errors_total??0}/></div><div className="card"><h3>Рабочие процессы</h3><Table title="Рабочие процессы" cols={['ID','Роль','Статус','Последняя активность']} rows={(d?.workers||[]).map((x:any)=>[x.id,x.role,x.status,x.last_seen_at])}/><button onClick={reload}>Обновить</button></div></div>}
function Jobs({d,reload}:any){return <div className="card"><h3>Очередь задач</h3><Table title="Задачи" cols={['ID','Тип','Статус','Попытки','Рабочий процесс','Ошибка','Действие']} rows={(d||[]).map((x:any)=>[x.id,x.kind,x.status,`${x.attempts}/${x.max_attempts}`,x.worker_id||'—',x.error||'—',x.status==='failed'&&<button onClick={async()=>{await req(`/api/admin/jobs/${x.id}/retry`,{method:'POST'});reload()}}>Повторить</button>])}/></div>}
