  {title:"Клиенты",items:[['users','◉','Пользователи'],['crm','◎','CRM'],['customer360','◉','Карточка клиента 360'],['supportPro','◒','Support Pro'],['fraud','⚠','Антифрод']]},
  {title:"Инфраструктура",items:[['nodes','⌁','Серверы Remnawave'],['routing','⇄','Smart Routing'],['devices','▣','Устройства'],['automation','⚡','Автоматизация'],['platform','◫','Платформа'],['monitoring','◉','Мониторинг'],['operations','⚙','Операции'],['deployments','⇄','Развёртывания'],['workers','◒','Рабочие процессы'],['jobs','☷','Очередь задач'],['capacity','▥','Capacity Planning'],['orchestrator','⚡','Node Orchestrator']]},
  {title:"Контент",items:[['content','✎','Бот и Mini App'],['cabinet','▤','Личный кабинет'],['apps','▣','Приложения'],['marketing','◇','Маркетинг'],['notifications','✉','Уведомления'],['branding','◈','Брендинг']]},
  {title:"Безопасность",items:[['security','◌','Безопасность'],['sessions','◴','Сессии'],['passkeys','◆','Ключи доступа'],['admins','♙','Администраторы'],['soc','⚠','Security Operations'],['audit','≡','Аудит'],['backups','▣','Бекапы'],['recovery','⚕','Восстановление']]},
  {title:"Продакшн",items:[['enterprise','✦','Корпоративный контур'],['releases','⇧','Релизы'],['incidents','⚠','Инциденты'],['providers','₽','Провайдеры'],['features','◇','Функции'],['staging','✓','Тестовый контур'],['integrations','⌘','API & Webhooks'],['events','⇄','Event Bus']]}
 ];
 const flat=groups.flatMap(g=>g.items); const current=flat.find(n=>n[0]===tab);
 async function load(){if(!auth)return;setLoading(true);try{const u:any={command360:"/api/admin/v6/command-center",capacity:"/api/admin/v6/capacity",commercial:"/api/admin/v6/commercial",integrations:"/api/admin/v6/integrations",events:"/api/admin/v6/events",soc:"/api/admin/v6/security-center",intelligence:"/api/admin/v6/intelligence",orchestrator:"/api/admin/v6/config/orchestrator",v3:"/api/admin/v3/control-center",routing:"/api/admin/v3/routing",devices:"/api/admin/v3/devices",automation:"/api/admin/v3/automation",branding:"/api/public/branding",enterprise:"/api/admin/enterprise/summary",dashboard:"/api/admin/overview",plans:"/api/admin/plans",constructor:"/api/admin/tariff-constructors",nodes:"/api/admin/remnawave/monitoring",platform:"/api/admin/platform/summary",payments:"/api/admin/payments",financial:"/api/admin/financial-ledger",users:"/api/admin/remnawave/users?size=50",content:"/api/admin/content",apps:"/api/admin/apps",cabinet:"/api/admin/cabinet/menu",marketing:"/api/admin/marketing",admins:"/api/admin/admins",security:"/api/admin/security",recovery:"/api/admin/recovery",sessions:"/api/admin/sessions",backups:"/api/admin/backups",audit:"/api/admin/audit",supportPro:"/api/admin/support-pro/status",refunds:"/api/admin/refunds",workers:"/api/admin/workers",releases:"/api/admin/releases",monitoring:"/api/admin/monitoring",jobs:"/api/admin/jobs",fraud:"/api/admin/fraud",payouts:"/api/admin/payouts",staging:"/api/admin/staging-e2e/config",operations:"/api/admin/v41/diagnostics",analytics:"/api/admin/v41/analytics",incidents:"/api/admin/v41/incidents",providers:"/api/admin/v41/providers",crm:"/api/admin/v41/crm/users",features:"/api/admin/v41/features",passkeys:"/api/admin/v41/passkeys",customer360:"/api/admin/customers/1/360",gifts:"/api/admin/gifts",health:"/api/admin/health/summary",status:"/api/admin/status/components",deployments:"/api/admin/deployments",notifications:"/api/admin/notifications"};
 if(tab==="enterprise"){const [summary,checks,campaigns,rules]=await Promise.all([req(u.enterprise),req("/api/admin/enterprise/monitoring"),req("/api/admin/enterprise/campaigns"),req("/api/admin/enterprise/rules")]);setD({summary,checks,campaigns,rules})}
 else if(tab==="backups"){const config=await req("/api/admin/backups/config");setD({config,items:await req(u[tab])})}
 else if(tab==="cabinet"){const [menu,guides]=await Promise.all([req("/api/admin/cabinet/menu"),req("/api/admin/cabinet/guides")]);setD({menu,guides})}
 else if(tab==="dashboard"){const [overview,analytics,health]=await Promise.all([req(u.dashboard),req("/api/admin/analytics"),req("/health")]);setD({...overview,analytics,health})}
 else setD(await req(u[tab]));setMsg("")}catch(x:any){setMsg(x.message);if(String(x.message).includes("401"))setAuth(false)}finally{setLoading(false)}}
 useEffect(()=>{loadBranding().then(b=>{setBranding({...DEFAULT_BRANDING,...b,name:"VPN Shop by Corgi"});applyBranding({...DEFAULT_BRANDING,...b,name:"VPN Shop by Corgi"})});req("/api/admin/security").then(()=>setAuth(true)).catch(()=>setAuth(false)).finally(()=>setBoot(false))},[]);
 useEffect(()=>{document.documentElement.dataset.theme=theme;localStorage.setItem("rw_theme",theme)},[theme]);useEffect(()=>{const h=(e:KeyboardEvent)=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==="k"){e.preventDefault();setCommand(true);setCommandQuery("")}if(e.key==="Escape")setCommand(false)};window.addEventListener("keydown",h);return()=>window.removeEventListener("keydown",h)},[]);useEffect(()=>{if(auth)load()},[tab,auth]);
 if(boot)return <DomLocalizer><div className="loading-screen"><div className="brand-pulse">C</div><b>VPN Shop by Corgi</b><span>Запуск панели…</span></div></DomLocalizer>;
 if(!auth)return <DomLocalizer><Вход onAuth={()=>setAuth(true)}/></DomLocalizer>;
 return <DomLocalizer><div className="app-shell"><aside className={mobile?"sidebar open":"sidebar"}><div className="brand"><div className="brand-icon">🐾</div><div><strong>VPN Shop by Corgi</strong><span>Control Center · Admin</span></div><button className="sidebar-close" onClick={()=>setMobile(false)}>×</button></div><div className="sidebar-scroll">{groups.map(g=><section className="nav-group" key={g.title}><div className="nav-group-title">{g.title}</div>{g.items.map(n=><button className={tab===n[0]?"nav-item active":"nav-item"} onClick={()=>{setTab(n[0]);setMobile(false)}} key={n[0]}><i>{n[1]}</i><span>{n[2]}</span>{tab===n[0]&&<em/>}</button>)}</section>)}</div><div className="sidebar-foot"><div className="online"><span/>Система в норме</div><button className="nav-item" onClick={async()=>{await req('/api/admin/auth/logout',{method:'POST'});setAuth(false)}}><i>↪</i><span>Выйти</span></button></div></aside><main className="workspace"><header className="topbar"><button className="mobile-menu" onClick={()=>setMobile(true)}>☰</button><div className="page-heading"><div className="breadcrumb">VPN SHOP / {current?.[2]?.toUpperCase()}</div><h1>{current?.[2]||"Обзор"}</h1></div><div className="topbar-actions"><div className="secure"><span/>Защищённая сессия</div><button className="round-btn" onClick={load} title="Обновить">↻</button><select value={theme} onChange={e=>setTheme(e.target.value)} aria-label="Тема">{THEMES.map(x=><option key={x}>{x}</option>)}</select><button className="round-btn" onClick={()=>setLang(lang==="ru"?"en":"ru")}>{lang==="ru"?"EN":"RU"}</button></div></header><div className="content-wrap">{msg&&<div className="alert">{msg}<button onClick={()=>setMsg("")}>×</button></div>}{loading&&<div className="loading-bar"/>}<Content tab={tab} d={d} reload={load} toast={setMsg} onBranding={setBranding} navigate={setTab}/></div>{command&&<div className="command-overlay" onClick={()=>setCommand(false)}><div className="command-box" onClick={e=>e.stopPropagation()}><input autoFocus value={commandQuery} onChange={e=>setCommandQuery(e.target.value)} placeholder="Поиск раздела…"/><div>{flat.filter(n=>n[2].toLowerCase().includes(commandQuery.toLowerCase())).slice(0,12).map(n=><button key={n[0]} onClick={()=>{setTab(n[0]);setCommand(false)}}><span>{n[1]}</span>{n[2]}<kbd>↵</kbd></button>)}</div></div></div>}</main></div></DomLocalizer>}

function AppsDesk({d,reload,toast}:any){
  const[rows,setRows]=useState<any[]>(d?.apps||[]);
  const[logo,setLogo]=useState<File|null>(null);
  const[packs,setPacks]=useState<Record<string,File|null>>({});
  useEffect(()=>{setRows(d?.apps||[])},[d]);
  function patch(id:string,key:string,value:any){setRows(rows.map(row=>row.id===id?{...row,[key]:value}:row))}
  async function save(){try{await req("/api/admin/apps",{method:"PUT",body:JSON.stringify({apps:rows})});toast("Приложения сохранены");reload()}catch(e:any){toast(e.message)}}
  async function upload(){if(!logo)return;const body=new FormData();body.append("file",logo);try{await req("/api/admin/apps/logo",{method:"POST",body});toast("Логотип обновлён");setLogo(null);reload()}catch(e:any){toast(e.message)}}
  async function removeLogo(){try{await req("/api/admin/apps/logo",{method:"DELETE"});toast("Логотип удалён");reload()}catch(e:any){toast(e.message)}}
  async function uploadPack(id:string){const file=packs[id];if(!file)return;const body=new FormData();body.append("file",file);try{await req("/api/admin/apps/"+id+"/file",{method:"POST",body});toast("Файл приложения сохранён");setPacks({...packs,[id]:null});reload()}catch(e:any){toast(e.message)}}
  async function removePack(id:string){try{await req("/api/admin/apps/"+id+"/file",{method:"DELETE"});toast("Файл приложения удалён");reload()}catch(e:any){toast(e.message)}}
  function storeHref(row:any){return typeof row.url==="string" && row.url.startsWith("https://") ? row.url : ""}
  function fileHref(row:any){return typeof row.download_url==="string" && row.download_url.startsWith("/api/admin/apps/") && row.download_url.endsWith("/download") ? API+row.download_url : ""}
  return <div>
    <div className="toolbar"><div><h2>Приложения</h2><p>Тексты и файлы покупателя видит личный кабинет. Здесь же скачивается приложение администратора.</p></div><button className="primary" onClick={save}>Сохранить приложения</button></div>
    <div className="card"><h3>Скачать приложение администратора</h3><div className="inline">{rows.filter((row:any)=>row.audience==="admin").map((row:any)=><span key={row.id}>{row.platform==="ios"?"iOS":"Android"} {fileHref(row)&&<a href={fileHref(row)}>Скачать</a>} {typeof row.sha256==="string"&&/^[a-f0-9]{64}$/.test(row.sha256)&&<code>Контрольная сумма {row.sha256}</code>} {storeHref(row)&&<a href={storeHref(row)} target="_blank" rel="noopener noreferrer">Ссылка</a>} {!fileHref(row)&&!storeHref(row)&&<em>Файл не загружен</em>}</span>)}</div></div>
    <div className="card"><h3>Логотип для кабинета и приложений</h3>{d?.logo_url&&<img src={API+d.logo_url} alt="" style={{width:72,height:72,objectFit:"contain"}}/>}<div className="inline"><input type="file" accept="image/png,image/jpeg,image/webp" onChange={e=>setLogo(e.target.files?.[0]||null)}/><button onClick={upload}>Загрузить логотип</button><button onClick={removeLogo}>Удалить логотип</button></div></div>
    <div className="grid2">{rows.map((row:any)=><div className="card" key={row.id}><h3>{row.platform==="ios"?"iOS":"Android"} · {row.audience==="admin"?"Администратор":"Покупатель"}</h3><label className="inline"><input type="checkbox" checked={!!row.enabled} onChange={e=>patch(row.id,"enabled",e.target.checked)}/>Показывать</label><label>Название RU<input value={row.title_ru||""} onChange={e=>patch(row.id,"title_ru",e.target.value)}/></label><label>Название EN<input value={row.title_en||""} onChange={e=>patch(row.id,"title_en",e.target.value)}/></label><label>Текст RU<textarea value={row.text_ru||""} onChange={e=>patch(row.id,"text_ru",e.target.value)}/></label><label>Текст EN<textarea value={row.text_en||""} onChange={e=>patch(row.id,"text_en",e.target.value)}/></label><label>Ссылка<input value={row.url||""} onChange={e=>patch(row.id,"url",e.target.value)} placeholder="https://"/></label><label>Файл приложения<input type="file" accept={row.platform==="ios"?".ipa":".apk"} onChange={e=>setPacks({...packs,[row.id]:e.target.files?.[0]||null})}/></label><div className="inline"><button onClick={()=>uploadPack(row.id)}>Загрузить файл</button>{row.has_file&&<button onClick={()=>removePack(row.id)}>Удалить файл</button>}{fileHref(row)&&<a href={fileHref(row)}>Скачать</a>}{typeof row.sha256==="string"&&/^[a-f0-9]{64}$/.test(row.sha256)&&<code>Контрольная сумма {row.sha256}</code>}</div></div>)}</div>
  </div>
}

