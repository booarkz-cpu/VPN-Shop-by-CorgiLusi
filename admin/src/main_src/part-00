 const[tab,setTab]=useState<Tab>("dashboard");const[d,setD]=useState<any>({});const[msg,setMsg]=useState("");const[loading,setLoading]=useState(false);const[mobile,setMobile]=useState(false);const[command,setCommand]=useState(false);const[commandQuery,setCommandQuery]=useState("");
 const groups:{title:string;items:[Tab,string,string][]}[]=[
  {title:"Главное",items:[['command360','✦','Corgi Command Center'],['intelligence','◇','Intelligence'],['v3','✦','Control Center'],['dashboard','⌂','Обзор'],['analytics','◌','Аналитика'],['health','♥','Состояние системы'],['status','●','Статус сервиса']]},
