import{createRoot}from"react-dom/client";import"./style.css";import"./design-system.css";
const API=import.meta.env.VITE_API_URL||"";
const STATUS_RU:any={pending:"ожидает",processing:"обрабатывается",failed:"ошибка",completed:"завершено",running:"выполняется",queued:"в очереди",paid:"оплачен",requested:"запрошен",approved:"одобрен",rejected:"отклонён",retry:"повтор",active:"активен",disabled:"отключён"}; const ru=(v:any)=>STATUS_RU[String(v)]||v||"—";
function csrf(){return decodeURIComponent(document.cookie.split('; ').find(x=>x.startsWith('rw_csrf='))?.split('=')[1]||'')}
async function req(path:string,opts:RequestInit={},token?:string){const method=(opts.method||'GET').toString().toUpperCase();const h:any={...(opts.headers||{})};if(!(opts.body instanceof FormData))h["Content-Type"]="application/json";if(token)h.Authorization=`Bearer ${token}`;if(method!=="GET")h["X-CSRF-Token"]=csrf();const r=await fetch(API+path,{...opts,headers:h,credentials:"include"});let d:any={};try{d=await r.json()}catch{}if(!r.ok)throw Error(d.detail||`HTTP ${r.status}`);return d}
type Branding={name:string;logo_url:string;favicon_url:string;theme_default:"light"|"dark"};
const DEFAULT_BRANDING:Branding={name:"VPN Shop by Corgi",logo_url:"",favicon_url:"",theme_default:"dark"};
function applyBranding(b:Branding){
 document.title=b.name || DEFAULT_BRANDING.name;
 const link=document.querySelector('link[rel="icon"]') as HTMLLinkElement|null;
 if(b.favicon_url){const el=link||document.createElement("link");el.rel="icon";el.href=API+b.favicon_url;if(!link)document.head.appendChild(el)}
 document.documentElement.style.setProperty("--brand-name",JSON.stringify(b.name||DEFAULT_BRANDING.name));
}
async function loadBranding():Promise<Branding>{try{const b=await req("/api/public/branding");return {...DEFAULT_BRANDING,...b}}catch{return DEFAULT_BRANDING}}

function Вход({onAuth}:{onAuth:()=>void}){const{lang,setLang}=useLang();const[branding,setBranding]=useState<Branding>(DEFAULT_BRANDING);const[e,setE]=useState("");const[p,setP]=useState("");const[o,setO]=useState("");const[m,setM]=useState("");const[busy,setBusy]=useState(false);useEffect(()=>{loadBranding().then(b=>{setBranding(b);applyBranding(b);document.documentElement.dataset.theme=localStorage.getItem("rw_theme")||b.theme_default})},[]);async function go(x:any){x.preventDefault();setBusy(true);setM("");try{await req("/api/admin/auth/login",{method:"POST",body:JSON.stringify({email:e,password:p,otp:o||null})});onAuth()}catch(x:any){setM(x.message)}finally{setBusy(false)}}async function telegram(){const initData=(window as any).Telegram?.WebApp?.initData;if(!initData){setM("Вход через Telegram доступен, если панель открыта внутри Telegram Web App");return}setBusy(true);try{await req("/api/admin/auth/telegram",{method:"POST",body:JSON.stringify({initData})});onAuth()}catch(x:any){setM(x.message)}finally{setBusy(false)}}return <div className="auth-shell"><div className="auth-art"><div className="brand-mark">{branding.logo_url?<img src={API+branding.logo_url} alt=""/>:"🐾"}</div><div className="eyebrow">ЦЕНТР УПРАВЛЕНИЯ · ПРОДАКШН</div><h1>{branding.name}.<br/><span>Под вашим контролем.</span></h1><p>Производственная веб-панель.</p></div><form className="auth-card" onSubmit={go}><div className="eyebrow">ВХОД АДМИНИСТРАТОРА</div><h2>Войти</h2><label>Email<input value={e} onChange={x=>setE(x.target.value)} autoComplete="username" required/></label><label>Пароль<input type="password" value={p} onChange={x=>setP(x.target.value)} autoComplete="current-password" required/></label><label>Код 2FA <small>если включена</small><input inputMode="numeric" maxLength={6} value={o} onChange={x=>setO(x.target.value.replace(/\D/g,""))}/></label><button className="primary" disabled={busy}>{busy?"Проверка…":"Войти"}</button><button type="button" onClick={telegram} disabled={busy}>Войти через Telegram</button><button type="button" title="Язык интерфейса" onClick={()=>setLang(lang==="ru"?"en":"ru")}>{lang==="ru"?"EN":"RU"}</button>{m&&<div className="error">{m}</div>}<div className="auth-foot">Защищённая cookie · CSRF · 30 минут</div></form></div>}

type Tab="v3"|"routing"|"devices"|"automation"|"branding"|"enterprise"|"dashboard"|"operations"|"analytics"|"incidents"|"providers"|"crm"|"features"|"passkeys"|"customer360"|"gifts"|"health"|"plans"|"constructor"|"nodes"|"platform"|"payments"|"financial"|"users"|"content"|"cabinet"|"marketing"|"admins"|"backups"|"security"|"recovery"|"sessions"|"audit"|"refunds"|"workers"|"releases"|"monitoring"|"jobs"|"fraud"|"payouts"|"staging"|"status"|"deployments"|"notifications"|"apps"|"supportPro"|"command360"|"capacity"|"orchestrator"|"commercial"|"integrations"|"events"|"soc"|"intelligence";
