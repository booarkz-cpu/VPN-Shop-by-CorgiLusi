function Content({tab,d,reload,toast,onBranding,navigate}:any){if(tab==="command360")return <Command360 d={d} navigate={navigate}/>;if(tab==="capacity")return <CapacityDesk d={d}/>;if(tab==="orchestrator")return <OrchestratorDesk d={d} reload={reload} toast={toast}/>;if(tab==="commercial")return <CommercialDesk d={d}/>;if(tab==="integrations")return <IntegrationsDesk d={d}/>;if(tab==="events")return <EventsDesk d={d}/>;if(tab==="soc")return <SocDesk d={d}/>;if(tab==="intelligence")return <IntelligenceDesk d={d}/>;if(tab==="v3")return <V3Control d={d} navigate={navigate} reload={reload} toast={toast}/>;if(tab==="routing")return <SmartRouting d={d} reload={reload} toast={toast}/>;if(tab==="devices")return <DevicesDesk d={d}/>;if(tab==="automation")return <AutomationDesk d={d} reload={reload}/>;if(tab==="apps")return <AppsDesk d={d} reload={reload} toast={toast}/>;if(tab==="branding")return <BrandingНастройки branding={d||DEFAULT_BRANDING} onChanged={(b:Branding)=>{applyBranding(b);onBranding?.(b);toast("Брендинг обновлён")}}/>;if(tab==="enterprise")return <Корпоративный d={d} reload={reload} toast={toast}/>;if(tab==="dashboard")return <Обзор d={d} navigate={navigate}/>;if(tab==="supportPro")return <SupportProDesk d={d} toast={toast}/>;if(tab==="refunds")return <Refunds d={d} reload={reload}/>;if(tab==="workers")return <Workers d={d} reload={reload}/>;if(tab==="releases")return <Releases d={d}/>;if(tab==="monitoring")return <Monitoring d={d} reload={reload}/>;if(tab==="jobs")return <Jobs d={d} reload={reload}/>;if(tab==="fraud")return <Fraud d={d} reload={reload}/>;if(tab==="payouts")return <Payouts d={d}/>;if(tab==="operations")return <Operations d={d} reload={reload}/>;if(tab==="analytics")return <AnalyticsV41 d={d}/>;if(tab==="incidents")return <Incidents d={d} reload={reload}/>;if(tab==="providers")return <Провайдерs d={d} reload={reload}/>;if(tab==="crm")return <CRM d={d}/>;if(tab==="features")return <Features d={d} reload={reload}/>;if(tab==="passkeys")return <Passkeys d={d} reload={reload}/>;if(tab==="customer360")return <Customer360 d={d}/>;if(tab==="gifts")return <Gifts d={d} reload={reload} toast={toast}/>;if(tab==="health")return <Состояние d={d}/>;if(tab==="status")return <Table title="Статус сервиса" cols={["Компонент","Статус","Сообщение"]} rows={(d||[]).map((x:any)=>[x.name,x.status,x.message||"—"])} />;if(tab==="deployments")return <Table title="Развёртывания" cols={["Версия","Стратегия","Трафик","Статус","Ошибки"]} rows={(d||[]).map((x:any)=>[x.version,x.strategy,`${x.traffic_percent}%`,x.status,`${x.error_rate_percent}%`])}/>;if(tab==="notifications")return <Table title="Уведомления" cols={["Пользователь","Канал","Тип","Статус","Создано"]} rows={(d||[]).map((x:any)=>[x.user_id,x.channel,x.kind,x.status,x.created_at])}/>;if(tab==="staging")return <StagingE2E d={d} reload={reload} toast={toast}/>;if(tab==="security")return <Security d={d} reload={reload} toast={toast}/>;if(tab==="recovery")return <Recovery d={d} reload={reload} toast={toast}/>;if(tab==="backups")return <Backups d={d} reload={reload} toast={toast}/>;if(tab==="sessions")return <Sessions d={d} reload={reload}/>;if(tab==="plans")return <Plans d={d} reload={reload}/>;if(tab==="constructor")return <TariffConstructorPanel d={d} reload={reload} toast={toast}/>;if(tab==="nodes")return <RemnawaveNodes d={d} reload={reload}/>;if(tab==="platform")return <PlatformDesk d={d} reload={reload} toast={toast}/>;if(tab==="cabinet")return <CabinetCMS d={d} reload={reload} toast={toast}/>;if(tab==="content")return <ContentEditor d={d} reload={reload} toast={toast}/>;if(tab==="marketing")return <Marketing d={d} reload={reload} toast={toast}/>;if(tab==="admins")return <Admins d={d} reload={reload} toast={toast}/>;if(tab==="payments")return <Платежи d={d} reload={reload}/>;if(tab==="financial")return <FinancialLedger d={d}/>;if(tab==="users")return <Table title="Пользователи Remnawave" cols={['ID','Имя пользователя','Статус','Создан']} rows={(d?.response?.users||d?.users||[]).map((x:any)=>[x.id,x.username||x.telegramId||'—',x.status||'—',x.createdAt||'—'])}/>;return <Table title="Журнал действий" cols={['Время','Администратор','Действие','Цель']} rows={(d||[]).map((x:any)=>[x.created_at,x.actor,x.action,x.target||'—'])}/>}
function PlatformDesk({d,reload,toast}:any){const[name,setName]=useState("");const[hwid,setHwid]=useState("");const[hook,setHook]=useState("");async function run(path:string,body:any,ok:string){try{const r=await req(path,{method:"POST",body:JSON.stringify(body)});toast(r.token?`${ok}: ${r.token}`:r.secret?`${ok}: ${r.secret}`:r.txt||ok);reload()}catch(e:any){toast(e.message)}}return <div><div className="toolbar"><div><h2>Платформа</h2><p>Антиабьюз, агенты узлов, ключи API, исходящие webhook и почта. Секрет показывается один раз.</p></div></div><div className="grid2"><div className="card"><h3>Модули</h3>{(d?.plugins||[]).map((p:any)=><div className="inline" key={p.key}><span>{p.key}</span><button onClick={()=>run(`/api/admin/platform/plugins/${p.key}`,{enabled:!p.enabled},p.enabled?"Модуль выключен":"Модуль включён")}>{p.enabled?"Включён":"Выключен"}</button></div>)}<h3>Агент узла</h3><div className="inline"><input placeholder="Имя узла" value={name} onChange={e=>setName(e.target.value)}/><button className="primary" onClick={()=>run("/api/admin/platform/agents",{name},"Токен агента")}> Создать агента</button></div></div></div></div>}