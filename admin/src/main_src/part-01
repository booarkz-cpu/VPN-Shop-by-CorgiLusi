function AppsDesk({d,reload,toast}:any){
  const[rows,setRows]=useState<any[]>(d?.apps||[]);
  const[logo,setLogo]=useState<File|null>(null);
  const[packs,setPacks]=useState<Record<string,File|null>>({});
  useEffect(()=>{setRows(d?.apps||[])},[d]);
  function patch(id:string,key:string,value:any){setRows(rows.map(row=>row.id===id?{...row,[key]:value}:row))}
  async function save(){try{await req("/api/admin/apps",{method:"PUT",body:JSON.stringify({apps:rows})});toast("Приложения сохранены");reload()}catch(e:any){toast(e.message)}}
  async function upload(){if(!logo)return;const body=new FormData();body.append("file",logo);try{await req("/api/admin/apps/logo",{method:"POST",body});toast("Логотип обновлён");setLogo(null);reload()}catch(e:any){toast(e.message)}}
  async function removeLogo(){try{await req("/api/admin/apps/logo",{method:"DELETE"});toast("Логотип удалён");reload()}catch(e:any){toast(e.message)}}
  async function uploadPack(id:string){const file=packs[id];if(!file)return;const body=new FormData();body.append("file",file);try{await req("/api/admin/apps/"+id+"/file",{method:"POST",body});toast("Файл приложения сохранён");setPacks({...packs,[id]:null});reload()}catch(e:any){toast(e.message)}}
  async function removePack(id:string){try{await req("/api/admin/apps/"+id+"/file",{method:"DELETE"});toast("Файл приложения удалён");reload()}catch(e:any){toast(e.message)}}
  function storeHref(row:any){return typeof row.url==="string" && row.url.startsWith("https://") ? row.url : ""}
  function fileHref(row:any){return typeof row.download_url==="string" && row.download_url.startsWith("/api/admin/apps/") && row.download_url.endsWith("/download") ? API+row.download_url : ""}
  return <div>
    <div className="toolbar"><div><h2>Приложения</h2><p>Тексты и файлы покупателя видит личный кабинет. Здесь же скачивается приложение администратора.</p></div><button className="primary" onClick={save}>Сохранить приложения</button></div>
