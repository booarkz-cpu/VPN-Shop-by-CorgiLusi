    <div className="card"><h3>Скачать приложение администратора</h3><div className="inline">{rows.filter((row:any)=>row.audience==="admin").map((row:any)=><span key={row.id}>{row.platform==="ios"?"iOS":"Android"} {fileHref(row)&&<a href={fileHref(row)}>Скачать</a>} {typeof row.sha256==="string"&&/^[a-f0-9]{64}$/.test(row.sha256)&&<code>Контрольная сумма {row.sha256}</code>} {storeHref(row)&&<a href={storeHref(row)} target="_blank" rel="noopener noreferrer">Ссылка</a>} {!fileHref(row)&&!storeHref(row)&&<em>Файл не загружен</em>}</span>)}</div></div>
    <div className="card"><h3>Логотип для кабинета и приложений</h3>{d?.logo_url&&<img src={API+d.logo_url} alt="" style={{width:72,height:72,objectFit:"contain"}}/>}<div className="inline"><input type="file" accept="image/png,image/jpeg,image/webp" onChange={e=>setLogo(e.target.files?.[0]||null)}/><button onClick={upload}>Загрузить логотип</button><button onClick={removeLogo}>Удалить логотип</button></div></div>
    <div className="grid2">{rows.map((row:any)=><div className="card" key={row.id}><h3>{row.platform==="ios"?"iOS":"Android"} · {row.audience==="admin"?"Администратор":"Покупатель"}</h3><label className="inline"><input type="checkbox" checked={!!row.enabled} onChange={e=>patch(row.id,"enabled",e.target.checked)}/>Показывать</label><label>Название RU<input value={row.title_ru||""} onChange={e=>patch(row.id,"title_ru",e.target.value)}/></label><label>Название EN<input value={row.title_en||""} onChange={e=>patch(row.id,"title_en",e.target.value)}/></label><label>Текст RU<textarea value={row.text_ru||""} onChange={e=>patch(row.id,"text_ru",e.target.value)}/></label><label>Текст EN<textarea value={row.text_en||""} onChange={e=>patch(row.id,"text_en",e.target.value)}/></label><label>Ссылка<input value={row.url||""} onChange={e=>patch(row.id,"url",e.target.value)} placeholder="https://"/></label><label>Файл приложения<input type="file" accept={row.platform==="ios"?".ipa":".apk"} onChange={e=>setPacks({...packs,[row.id]:e.target.files?.[0]||null})}/></label><div className="inline"><button onClick={()=>uploadPack(row.id)}>Загрузить файл</button>{row.has_file&&<button onClick={()=>removePack(row.id)}>Удалить файл</button>}{fileHref(row)&&<a href={fileHref(row)}>Скачать</a>}{typeof row.sha256==="string"&&/^[a-f0-9]{64}$/.test(row.sha256)&&<code>Контрольная сумма {row.sha256}</code>}</div></div>)}</div>
  </div>
}

function V3Control({d,navigate,reload,toast}:any){
 const k=d?.kpis||{};
 return <>
  <div className="stats"><Stat title="Пользователи" value={k.users||0} icon="◉"/><Stat title="Активные VPN" value={k.active_subscriptions||0} icon="⌁"/><Stat title="Устройства" value={k.devices||0} icon="▣"/><Stat title="Выручка" value={`${k.revenue||0}`} icon="₽"/></div>
  <div className="grid2">
   <div className="card"><div className="toolbar"><div><h3>Операционный центр</h3><p className="muted">Единая точка управления продажами, VPN и клиентами.</p></div><button onClick={reload}>Обновить</button></div>
    <div className="quick-actions"><button className="primary" onClick={()=>navigate("nodes")}>Управление нодами</button><button onClick={()=>navigate("routing")}>Smart Routing</button><button onClick={()=>navigate("devices")}>Устройства</button><button onClick={()=>navigate("automation")}>Автоматизация</button></div>
    <Row k="Платежи ожидают" v={k.pending_payments||0}/><Row k="Ошибки платежей" v={k.failed_payments||0}/><Row k="Активные правила" v={k.automation_rules||0}/><Row k="Кампании" v={k.campaigns||0}/>
   </div>
   <div className="card"><h3>Последние платежи</h3><Table title="Транзакции" cols={["ID","User","Сумма","Статус"]} rows={(d?.recent_payments||[]).map((x:any)=>[x.id,x.user_id,`${x.amount} ${x.currency}`,ru(x.status)])}/></div>
  </div>
 </>
}
function SmartRouting({d,reload,toast}:any){
 const [form,setForm]=useState<any>(d||{});
 useEffect(()=>setForm(d||{}),[d]);
 async function save(){try{await req('/api/admin/v3/routing',{method:'PUT',body:JSON.stringify({...form,preferred_countries:String(form.preferred_countries||'').split(',').map((x:string)=>x.trim().toUpperCase()).filter(Boolean)})});toast('Smart Routing сохранён');reload()}catch(e:any){toast(e.message)}}
 return <div className="grid2"><div className="card"><h3>Smart Routing</h3><p className="muted">Выбирает доступную ноду по нагрузке, стране и состоянию здоровья.</p><label className="inline"><input type="checkbox" checked={!!form.enabled} onChange={e=>setForm({...form,enabled:e.target.checked})}/>Включено</label><label>Стратегия<select value={form.strategy||'latency_load'} onChange={e=>setForm({...form,strategy:e.target.value})}><option value="latency_load">Latency + Load</option><option value="country_first">Страна → Load</option><option value="round_robin">Round Robin</option></select></label><label>Максимальная нагрузка %<input type="number" min="10" max="100" value={form.max_load_percent||85} onChange={e=>setForm({...form,max_load_percent:Number(e.target.value)})}/></label><label>Предпочтительные страны<input value={Array.isArray(form.preferred_countries)?form.preferred_countries.join(', '):form.preferred_countries||''} onChange={e=>setForm({...form,preferred_countries:e.target.value})} placeholder="DE, NL, FI"/></label><label className="inline"><input type="checkbox" checked={!!form.fallback_enabled} onChange={e=>setForm({...form,fallback_enabled:e.target.checked})}/>Fallback</label><button className="primary" onClick={save}>Сохранить</button></div><div className="card"><h3>Правила маршрутизации</h3><Row k="Health window" v={`${form.health_window_seconds||300} сек.`}/><Row k="Fallback" v={form.fallback_enabled?'включён':'выключен'}/><p className="muted">Пользователь получает рекомендацию через /api/me/routing/recommendation; адреса и служебные данные нод наружу не выдаются.</p></div></div>
}
function DevicesDesk({d}:any){return <div className="card"><div className="toolbar"><div><h3>Device Management</h3><p className="muted">Активные устройства пользователей и последние подключения.</p></div><span>{(d||[]).length} устройств</span></div><Table title="Устройства" cols={["ID","User","Устройство","Платформа","Статус","IP","Последняя активность"]} rows={(d||[]).map((x:any)=>[x.id,x.username||x.email||x.user_id,x.name,x.platform||'—',ru(x.status),x.last_ip||'—',x.last_seen_at||'—'])}/></div>}
function AutomationDesk({d,reload}:any){return <div className="grid2"><div className="card"><h3>Automation Center</h3><p className="muted">События, условия и действия управляются существующим engine.</p>{(d?.rules||[]).map((x:any)=><div className="automation-row" key={x.id}><div><b>{x.name}</b><span>{x.event} · priority {x.priority}</span></div><label className="inline"><input type="checkbox" checked={!!x.enabled} onChange={async e=>{await req(`/api/admin/v3/automation/${x.id}/toggle`,{method:'POST',body:JSON.stringify({enabled:e.target.checked})});reload()}}/>Включено</label></div>)}</div><div className="card"><h3>Campaign Manager</h3><Table title="Кампании" cols={["Название","Тип","Статус","Отправлено","Ошибки"]} rows={(d?.campaigns||[]).map((x:any)=>[x.name,x.kind,ru(x.status),x.sent_count,x.failed_count])}/></div></div>}

