function Fraud({d,reload}:any){return <div className="card"><div className="toolbar"><h3>Антифрод</h3><button className="primary" onClick={async()=>{await req('/api/admin/fraud/scan',{method:'POST'});reload()}}>Сканировать</button></div><Table title="Сигналы" cols={['ID','Пользователь','IP','Тип','Оценка','Статус','Подробности']} rows={(d||[]).map((x:any)=>[x.id,x.user_id||'—',x.ip||'—',x.kind,x.score,ru(x.status),x.details||'—'])}/></div>}
function Payouts({d}:any){return <div className="card"><h3>Центр выплат</h3><Table title="Выплаты" cols={['ID','Заявка','Провайдер','Сумма','Статус','Внешний ID']} rows={(d||[]).map((x:any)=>[x.id,x.withdrawal_id,x.provider,x.amount,ru(x.status),x.external_id||'—'])}/></div>}

function Operations({d,reload}:any){return <div className="grid2"><div className="card"><h3>Центр диагностики</h3><Row k="Общий статус" v={d?.status||"—"}/>{(d?.checks||[]).map((x:any)=><Row key={x.name} k={x.name} v={x.status+(x.latency_ms!=null?` · ${x.latency_ms} мс`:"")+(x.error?` · ${x.error}`:"")}/>)}<button onClick={reload}>Проверить снова</button></div><div className="card"><h3>Готовность production</h3><p className="muted">Перед включением реальных платежей сначала должен пройти staging E2E. Диагностика не снимает платёжный gate.</p></div></div>}
function AnalyticsV41({d}:any){return <><div className="stats"><Stat title="Пользователи" value={d?.users?.total||0} icon="◉"/><Stat title="Новые за 30 дней" value={d?.users?.new_30d||0} icon="+"/><Stat title="Оплачено" value={d?.payments?.paid||0} icon="₽"/><Stat title="Конверсия" value={`${d?.payments?.conversion_percent||0}%`} icon="%"/></div><div className="grid2"><div className="card"><h3>Выручка</h3><Row k="За всё время" v={`${d?.revenue?.all_time||0} ${d?.revenue?.currency||''}`}/><Row k="За 30 дней" v={`${d?.revenue?.last_30d||0} ${d?.revenue?.currency||''}`}/><Row k="Средний чек" v={`${d?.revenue?.average_paid_check||0} ${d?.revenue?.currency||''}`}/></div><div className="card"><h3>Возвраты</h3><Row k="Завершённые возвраты" v={d?.refunds||0}/></div></div></>}
function Incidents({d,reload}:any){async function create(){const title=prompt(t("Название инцидента"));if(!title)return;await req('/api/admin/v41/incidents',{method:'POST',body:JSON.stringify({severity:'high',category:'manual',title,details:''})});reload()}return <><div className="toolbar"><h3>Центр инцидентов</h3><button className="primary" onClick={create}>Создать инцидент</button></div><Table title="Инциденты" cols={['ID','Уровень','Категория','Название','Статус','Создан','Действие']} rows={(d||[]).map((x:any)=>[x.id,ru(x.severity),x.category,x.title,ru(x.status),x.created_at,x.status==='open'&&<button onClick={async()=>{await req(`/api/admin/v41/incidents/${x.id}/resolve`,{method:'POST'});reload()}}>Закрыть</button>])}/></>}
function Провайдерs({d,reload}:any){return <Table title="Платёжные провайдеры" cols={['Провайдер','Включён','Приоритет','Успешно','Ошибки','Задержка','Автоматический circuit']} rows={(d||[]).map((x:any)=>[x.provider,x.enabled?'да':'нет',x.priority,x.success_count,x.failure_count,x.last_latency_ms?`${x.last_latency_ms} мс`:'—',x.circuit_open_until||'закрыт'])}/>}
function CRM({d}:any){return <Table title="Клиенты пользователей" cols={['ID','Telegram ID','Имя','Реферальный код','Автопродление','Создан']} rows={(d||[]).map((x:any)=>[x.id,x.telegram_id||'—',x.username||'—',x.referral_code,x.auto_renew?'да':'нет',x.created_at])}/>}
function Features({d,reload}:any){return <Table title="Флаги функций" cols={['Функция','Состояние','Описание','Действие']} rows={(d||[]).map((x:any)=>[x.key,x.enabled?'включена':'выключена',x.description,<button onClick={async()=>{await req(`/api/admin/v41/features/${x.key}`,{method:'PUT',body:JSON.stringify({enabled:!x.enabled})});reload()}}>{x.enabled?'Выключить':'Включить'}</button>])}/>}
function Passkeys({d,reload}:any){return <div className="card"><h3>Ключи доступа / WebAuthn</h3><p className="muted">Хранилище credential-ов подготовлено, но браузерная регистрация и криптографическая проверка assertion не включаются автоматически. Это предотвращает ложное ощущение MFA-защиты.</p><Table title="Зарегистрированные ключи" cols={['ID','Название','Создан','Последнее использование','Счётчик']} rows={(d||[]).map((x:any)=>[x.id,x.name,x.created_at,x.last_used_at||'—',x.sign_count,<button onClick={async()=>{await req(`/api/admin/v41/passkeys/${x.id}`,{method:'DELETE'});reload()}}>Удалить</button>])}/></div>}

function Command360({d,navigate}:any){return <><div className="hero"><div><div className="eyebrow">CORGI COMMAND CENTER · LIVE CONTROL PLANE</div><h2>Всё, что требует внимания — на одном экране.</h2><p>Продажи, инфраструктура, безопасность и риск объединены без дублирования источников данных.</p></div><div className="hero-glow">🐾</div></div><div className="stats"><Stat title="Пользователи" value={d?.kpis?.users||0} icon="◉"/><Stat title="Активные подписки" value={d?.kpis?.active_subscriptions||0} icon="✓"/><Stat title="Выручка 30д" value={d?.kpis?.revenue_30d||0} icon="€"/><Stat title="Проблемы" value={(d?.attention||[]).length} icon="!"/></div><div className="grid2"><div className="card"><h3>Требует внимания</h3>{!(d?.attention||[]).length?<p className="muted">Критических сигналов нет.</p>:(d.attention||[]).map((x:any,i:number)=><div className="alert" key={i}><b>{x.severity}</b> · {x.text}</div>)}</div><div className="card"><h3>Node agents</h3>{(d?.nodes||[]).map((x:any)=><Row key={x.id} k={x.name} v={`${x.online?'● online':'○ offline'} · CPU ${x.cpu||'—'} · RAM ${x.mem||'—'}`}/>)}</div></div><div className="quick-actions"><button onClick={()=>navigate('capacity')}>Capacity Planning</button><button onClick={()=>navigate('orchestrator')}>Auto-Healing</button><button onClick={()=>navigate('soc')}>Security Operations</button><button onClick={()=>navigate('supportPro')}>Support Pro</button></div></>}
function CapacityDesk({d}:any){return <><div className="hero"><div><div className="eyebrow">CAPACITY · FORECAST</div><h2>Планирование VPN-инфраструктуры.</h2><p>Состояние агентов и прогноз достижения критической нагрузки.</p></div></div><Table title="Ноды" cols={['Нода','Нагрузка','Состояние','Прогноз до порога']} rows={(d?.nodes||[]).map((x:any)=>[x.name,`${x.load}%`,x.state,`${x.forecast_days} дн.`])}/><div className="card"><Row k="Рекомендуется добавить нод" v={d?.recommendation?.add_nodes||0}/><p className="muted">{d?.recommendation?.note}</p></div></>}
