      <button onClick={()=>navigate?.("payments")}><b>Платежи</b><br/><small>Проверить транзакции</small></button>
      <button onClick={()=>navigate?.("users")}><b>Пользователи</b><br/><small>Управление клиентами</small></button>
      <button onClick={()=>navigate?.("nodes")}><b>Серверы</b><br/><small>VPN-инфраструктура</small></button>
    </div>
   </div>
  </div>
  <div className="grid2">
   <div className="card"><h3>Выручка</h3><Row k="24 часа" v={`${a?.revenue?.['24h']||0} ₽`}/><Row k="7 дней" v={`${a?.revenue?.['7d']||0} ₽`}/><Row k="30 дней" v={`${revenue} ₽`}/></div>
   <div className="card"><h3>Безопасность</h3><Row k="MFA" v={d?.security?.mfa_enabled?'ВКЛ':'ПРОВЕРЬТЕ'}/><Row k="Активные сессии" v={d?.security?.active_sessions||'—'}/><Row k="Инцидент" v={d?.security?.incident_mode?'ТРЕВОГА':'Нет'}/></div>
  </div>
 </>
}
function Stat({title,value,icon}:any){return <div className="stat"><div className="stat-icon">{icon}</div><div><span>{title}</span><strong>{value}</strong></div></div>}
function Платежи({d,reload}:any){return <><div className="toolbar"><h3>Платежи</h3><button className="primary" onClick={async()=>{await req("/api/admin/payments/reconcile",{method:"POST"});reload()}}>Сверить платежи</button></div><Table title="Платежи" cols={['ID','Провайдер','Сумма','Платёж','Выдача','Попытки','Действие']} rows={(d||[]).map((x:any)=>{const retry=x.fulfillment_status==='failed'?<button onClick={async()=>{await req(`/api/admin/payments/${x.id}/retry`,{method:'POST'});reload()}}>Повторить</button>:null;return [x.id,x.provider,`${x.amount} ${x.currency}`,ru(x.status),ru(x.fulfillment_status),x.fulfillment_attempts,retry]})}/></>}

function Sessions({d,reload}:any){return <><div className="toolbar"><h3>Активные сессии</h3><button className="danger" onClick={async()=>{if(confirm(t('Завершить все ваши сессии?'))){await req('/api/admin/sessions/revoke-all',{method:'POST'});location.reload()}}}>Завершить все</button></div><Table title="Активные сессии" cols={['ID','Администратор','IP','Браузер','Последняя активность','Истекает','Действие']} rows={(d||[]).map((x:any)=>{const action=<button onClick={async()=>{await req(`/api/admin/sessions/${x.id}`,{method:'DELETE'});reload()}}>Завершить</button>;return [x.id,x.admin_email,x.ip,x.user_agent,x.last_seen_at,x.expires_at,action]})}/></>}

function Security({d,reload,toast}:any){const[setup,setSetup]=useState<any>();const[code,setCode]=useState("");const[pw,setPw]=useState("");async function start(){setSetup(await req('/api/admin/auth/mfa/setup',{method:'POST'}))}async function enable(){await req('/api/admin/auth/mfa/enable',{method:'POST',body:JSON.stringify({otp:code})});setSetup(null);toast('2FA включена');reload()}async function disable(){if(!confirm(t('Отключить 2FA?')))return;await req('/api/admin/auth/mfa/disable',{method:'POST',body:JSON.stringify({password:pw})});setPw('');toast('2FA отключена');reload()}return <div className="grid2"><div className="card"><h3>Безопасность</h3><Row k="2FA / TOTP" v={d?.mfa_enabled?'ВКЛ':'ВЫКЛ'}/><Row k="Авторизация" v="HttpOnly + CSRF"/><Row k="Права доступа" v="viewer / operator / admin"/><Row k="Ограничение запросов" v="Redis"/><Row k="Разрешение реальных платежей" v={d?.production_payments_enabled?"ВКЛ — разрешено":"ВЫКЛ — заблокировано"}/>{!d?.mfa_enabled?<button className="primary" onClick={start}>Включить 2FA</button>:<><input type="password" placeholder="Пароль" value={pw} onChange={e=>setPw(e.target.value)}/><button className="danger" onClick={disable}>Отключить 2FA</button></>}<div className="inline"><button className="primary" onClick={async()=>{await req("/api/admin/payments/production-gate",{method:"POST",body:JSON.stringify({enabled:true})});toast("Реальные платежи разрешены после проверки staging E2E");reload()}}>Разрешить реальные платежи</button><button onClick={async()=>{await req("/api/admin/payments/production-gate",{method:"POST",body:JSON.stringify({enabled:false})});toast("Реальные платежи заблокированы");reload()}}>Заблокировать</button></div></div><div className="card">{setup?<><h3>Настройка TOTP</h3><div className="secret">{setup.secret}</div><code>{setup.otpauth_url}</code><p><b>Коды восстановления — сохраните офлайн:</b></p><code>{(setup.recovery_codes||[]).join(" ")}</code><input inputMode="numeric" maxLength={6} value={code} onChange={e=>setCode(e.target.value.replace(/\D/g,''))}/><button className="primary" onClick={enable}>Подтвердить</button></>:<><h3>Защита production</h3><p className="muted">Redis rate limiting, HttpOnly cookies, CSRF, strict HTTPS URLs и webhook IP allowlist.</p></>}</div></div>}
function Backups({d,reload,toast}:any){const[c,setC]=useState(d?.config||{});useEffect(()=>setC(d?.config||{}),[d?.config]);async function save(){await req('/api/admin/backups/config',{method:'PUT',body:JSON.stringify({...c,retention:Number(c.retention),password:c.password||null})});toast('Настройки backup сохранены');reload()}async function run(){await req('/api/admin/backups/run',{method:'POST'});toast('Backup запущен');reload()}return <div className="grid2"><div className="card"><h3>Backup & Аварийное восстановление</h3><label>Расписание<select value={c.schedule||'off'} onChange={e=>setC({...c,schedule:e.target.value})}><option value="off">Выкл.</option><option value="6h">6 часов</option><option value="12h">12 часов</option><option value="24h">24 часа</option></select></label><label>Retention<input type="number" min="1" max="90" value={c.retention??7} onChange={e=>setC({...c,retention:e.target.value})}/></label><label>Пароль шифрования<input type="password" value={c.password||''} onChange={e=>setC({...c,password:e.target.value})}/></label><label><input type="checkbox" checked={c.encrypt!==false} onChange={e=>setC({...c,encrypt:e.target.checked})}/> Шифровать</label><label><input type="checkbox" checked={c.include_env!==false} onChange={e=>setC({...c,include_env:e.target.checked})}/> Включать .env</label><label><input type="checkbox" checked={!!c.s3_enabled} onChange={e=>setC({...c,s3_enabled:e.target.checked})}/> Off-site S3/R2/B2</label><label>S3 bucket<input value={c.s3_bucket||''} onChange={e=>setC({...c,s3_bucket:e.target.value})}/></label><label>S3 prefix<input value={c.s3_prefix||'vpn-shop'} onChange={e=>setC({...c,s3_prefix:e.target.value})}/></label><button className="primary" onClick={save}>Сохранить</button><button onClick={run}>Создать сейчас</button></div><Table title="История" cols={['Дата','Статус','Файл','SHA-256','Размер','Действия']} rows={(d.items||[]).map((x:any)=>[x.created_at,x.status,x.filename||x.error||'—',x.sha256||'—',x.size_bytes?`${(x.size_bytes/1024/1024).toFixed(1)} MB`:'—',x.filename&&<><button onClick={async()=>{const r=await req(`/api/admin/backups/${x.id}/verify`,{method:'POST'});toast(r.ok?'Checksum Работает':'Checksum mismatch')}}>Проверить</button><button onClick={async()=>{const r=await req(`/api/admin/backups/${x.id}/validate`,{method:'POST'});toast(r.ok?'Архив валиден':'Архив повреждён')}}>Validate</button><button className="danger" onClick={async()=>{if(!confirm(t('Восстановление перезапишет данные БД. Продолжить?')))return;const otp=prompt(t('Код 2FA (если включена)'))||'';await req(`/api/admin/backups/${x.id}/restore?confirm=RESTORE&otp=${encodeURIComponent(otp)}`,{method:'POST'});toast('Restore завершён');location.reload()}}>Restore</button></>])}/></div>}
