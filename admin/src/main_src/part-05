function CabinetCMS({d,reload,toast}:any){const[menu,setMenu]=useState<any[]>(d?.menu||[]);const[guides,setGuides]=useState<any>(d?.guides||{});const[form,setForm]=useState({title:"",slug:"",kind:"custom",body:"",sort_order:"100",enabled:true});useEffect(()=>{setMenu(d?.menu||[]);setGuides(d?.guides||{})},[d]);async function create(){try{await req("/api/admin/cabinet/menu",{method:"POST",body:JSON.stringify({...form,sort_order:Number(form.sort_order||0)})});toast("Вкладка кабинета создана");setForm({title:"",slug:"",kind:"custom",body:"",sort_order:"100",enabled:true});reload()}catch(e:any){toast(e.message)}}async function save(item:any){try{await req(`/api/admin/cabinet/menu/${item.id}`,{method:"PUT",body:JSON.stringify({title:item.title,slug:item.slug,kind:item.kind,body:item.body||"",sort_order:Number(item.sort_order||0),enabled:!!item.enabled})});toast("Вкладка сохранена");reload()}catch(e:any){toast(e.message)}}async function remove(id:number){if(!confirm(t("Удалить вкладку?")))return;try{await req(`/api/admin/cabinet/menu/${id}`,{method:"DELETE"});toast("Вкладка удалена");reload()}catch(e:any){toast(e.message)}}async function saveGuide(platform:string){try{await req(`/api/admin/cabinet/guides/${platform}`,{method:"PUT",body:JSON.stringify({value:guides[platform]||""})});toast(`Инструкция ${platform} сохранена`)}catch(e:any){toast(e.message)}}return <><div className="hero"><div><div className="eyebrow">ЛИЧНЫЙ КАБИНЕТ · CMS</div><h2>Меню и инструкции устройств.</h2><p>Редактируйте вкладки пользовательского кабинета и тексты подключения для Android, iOS, TV и компьютеров.</p></div><div className="hero-glow">◫</div></div><div className="grid2"><div className="card"><div className="toolbar"><h3>Вкладки кабинета</h3></div><div className="form-grid"><input placeholder="Название" value={form.title} onChange={e=>setForm({...form,title:e.target.value})}/><input placeholder="slug" value={form.slug} onChange={e=>setForm({...form,slug:e.target.value.toLowerCase().replace(/[^a-z0-9_-]/g,"")})}/><select value={form.kind} onChange={e=>setForm({...form,kind:e.target.value})}><option value="overview">Обзор</option><option value="plans">Тарифы</option><option value="trial">Пробный период</option><option value="connection">Подключение</option><option value="support">Поддержка</option><option value="servers">Серверы</option><option value="custom">Произвольная</option></select><input placeholder="Порядок" value={form.sort_order} onChange={e=>setForm({...form,sort_order:e.target.value})}/><textarea placeholder="HTML/текст для произвольной вкладки" value={form.body} onChange={e=>setForm({...form,body:e.target.value})}/><button className="primary" onClick={create}>Добавить вкладку</button></div>{menu.map((x:any)=><div className="card" key={x.id} style={{marginTop:12}}><div className="inline"><input value={x.title} onChange={e=>setMenu(menu.map((q:any)=>q.id===x.id?{...q,title:e.target.value}:q))}/><input value={x.slug} onChange={e=>setMenu(menu.map((q:any)=>q.id===x.id?{...q,slug:e.target.value}:q))}/><select value={x.kind} onChange={e=>setMenu(menu.map((q:any)=>q.id===x.id?{...q,kind:e.target.value}:q))}><option value="overview">Обзор</option><option value="plans">Тарифы</option><option value="trial">Пробный период</option><option value="connection">Подключение</option><option value="support">Поддержка</option><option value="servers">Серверы</option><option value="custom">Произвольная</option></select><input className="small-input" value={x.sort_order} onChange={e=>setMenu(menu.map((q:any)=>q.id===x.id?{...q,sort_order:e.target.value}:q))}/><label className="check"><input type="checkbox" checked={!!x.enabled} onChange={e=>setMenu(menu.map((q:any)=>q.id===x.id?{...q,enabled:e.target.checked}:q))}/> вкл</label><button className="primary" onClick={()=>save(x)}>Сохранить</button><button className="danger" style={{marginTop:0}} onClick={()=>remove(x.id)}>×</button></div>{x.kind==="custom"&&<textarea rows={4} style={{marginTop:10}} value={x.body||""} onChange={e=>setMenu(menu.map((q:any)=>q.id===x.id?{...q,body:e.target.value}:q))}/>}</div>)}</div><div className="card"><h3>Инструкции по устройствам</h3><p className="muted">Тексты показываются во вкладке «Подключение» личного кабинета.</p>{["android","ios","tv","windows","macos","linux"].map(p=><div key={p} style={{marginBottom:14}}><label>{p}<textarea rows={3} value={guides[p]||""} onChange={e=>setGuides({...guides,[p]:e.target.value})}/></label><button className="primary" onClick={()=>saveGuide(p)}>Сохранить {p}</button></div>)}</div></div></>}
function Customer360({d}:any){const[id,setId]=useState("");const[data,setData]=useState<any>(d);async function load(){if(!id)return;try{setData(await req(`/api/admin/customers/${Number(id)}/360`))}catch(e:any){alert(e.message)}}return <><div className="card"><div className="toolbar"><h3>Карточка клиента 360</h3><div className="inline"><input placeholder="ID пользователя" value={id} onChange={e=>setId(e.target.value)}/><button className="primary" onClick={load}>Открыть</button></div></div><pre style={{whiteSpace:"pre-wrap",color:"#9ca7ba"}}>{JSON.stringify(data,null,2)}</pre></div></>}
function Gifts({d,reload,toast}:any){const[code,setCode]=useState("");const[plan,setPlan]=useState("");const[days,setDays]=useState("");const[uses,setUses]=useState("1");async function create(){try{await req('/api/admin/gifts',{method:'POST',body:JSON.stringify({code,plan_id:Number(plan),duration_days:days?Number(days):null,max_uses:Number(uses)})});toast('Подарочный код создан');setCode('');reload()}catch(e:any){toast(e.message)}}return <div className="card"><div className="toolbar"><h3>Подарочные коды</h3></div><div className="inline"><input placeholder="CODE" value={code} onChange={e=>setCode(e.target.value.toUpperCase())}/><input placeholder="Plan ID" value={plan} onChange={e=>setPlan(e.target.value)}/><input placeholder="Дней" value={days} onChange={e=>setDays(e.target.value)}/><input placeholder="Использований" value={uses} onChange={e=>setUses(e.target.value)}/><button className="primary" onClick={create}>Создать</button></div><Table title="Коды" cols={['Код','Plan','Дней','Использовано','Лимит','Статус']} rows={(d||[]).map((x:any)=>[x.code,x.plan_id,x.duration_days||'по тарифу',x.used_count,x.max_uses,x.enabled?'активен':'выключен'])}/></div>}
function Состояние({d}:any){return <div className="card"><h3>Состояние системы</h3><div className="security-list">{(d?.checks||[]).map((x:any)=><div className="health" key={x.name}><span className={x.status==='ok'?'ok':''}>●</span><div><b>{x.name}</b><small>{x.error||'Работает'}</small></div><em>{x.latency_ms?`${x.latency_ms} ms`:x.status}</em></div>)}</div><p className="muted">Режим инцидента: {d?.incident_mode?'ON':'OFF'} · Платежи: {d?.payments_paused?'PAUSED':'ENABLED'}</p></div>}

function BrandingНастройки({branding,onChanged}:{branding:Branding;onChanged:(b:Branding)=>void}){
 const[name,setName]=useState(branding.name);const[theme,setTheme]=useState(branding.theme_default);const[logo,setLogo]=useState<File|null>(null);const[favicon,setFavicon]=useState<File|null>(null);const[busy,setBusy]=useState(false);
 useEffect(()=>{setName(branding.name);setTheme(branding.theme_default)},[branding.name,branding.theme_default]);
 async function save(){setBusy(true);try{await req("/api/admin/settings/app_name",{method:"PUT",body:JSON.stringify({value:name.trim()})});await req("/api/admin/settings/theme_default",{method:"PUT",body:JSON.stringify({value:theme})});let b={...branding,name:name.trim(),theme_default:theme as "light"|"dark"};if(logo){const f=new FormData();f.append("file",logo);const r=await req("/api/admin/branding/logo",{method:"POST",body:f});b.logo_url=r.url}if(favicon){const f=new FormData();f.append("file",favicon);const r=await req("/api/admin/branding/favicon",{method:"POST",body:f});b.favicon_url=r.url}onChanged(b);setLogo(null);setFavicon(null);toastOk("Брендинг сохранён")}catch(e:any){toastOk(e.message)}finally{setBusy(false)}}
 function toastOk(x:string){const el=document.getElementById("branding-message");if(el)el.textContent=x}
