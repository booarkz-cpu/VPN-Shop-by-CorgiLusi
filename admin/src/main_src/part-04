function TariffConstructorPanel({d,reload,toast}:any){const rows=Array.isArray(d)?d:[];const blank=(kind:string)=>({kind,label:kind==="devices"?"1 устройство":kind==="traffic_gb"?"Безлимит":"30 дней",value:kind==="devices"?1:kind==="days"?30:0,price:"0",enabled:true,sort_order:0});const empty={name:"",description:"",base_price:"0",remnawave_profile_id:"",enabled:true,sort_order:"0",options:[blank("devices"),blank("traffic_gb"),blank("days")]};const[form,setForm]=useState<any>(empty);const[editing,setEditing]=useState<number|null>(null);function setOpt(i:number,patch:any){const options=[...form.options];options[i]={...options[i],...patch};setForm({...form,options})}async function save(){const body={name:form.name,description:form.description||"",base_price:Number(form.base_price||0),enabled:!!form.enabled,remnawave_profile_id:form.remnawave_profile_id||null,sort_order:Number(form.sort_order||0),options:form.options.map((o:any,i:number)=>({kind:o.kind,label:String(o.label||"Пункт"),value:Number(o.value),price:Number(o.price||0),enabled:o.enabled!==false,sort_order:Number(o.sort_order??i)}))};try{if(editing)await req(`/api/admin/tariff-constructors/${editing}`,{method:"PUT",body:JSON.stringify(body)});else await req("/api/admin/tariff-constructors",{method:"POST",body:JSON.stringify(body)});toast(editing?"Конструктор сохранён":"Конструктор создан");setEditing(null);setForm(empty);reload()}catch(e:any){toast(e.message)}}function edit(row:any){setEditing(row.id);setForm({name:row.name,description:row.description||"",base_price:String(row.base_price),remnawave_profile_id:row.remnawave_profile_id||"",enabled:!!row.enabled,sort_order:String(row.sort_order||0),options:(row.options||[]).map((o:any)=>({...o,price:String(o.price)}))})}async function disable(id:number){if(!confirm(t("Отключить конструктор?")))return;try{await req(`/api/admin/tariff-constructors/${id}`,{method:"DELETE"});toast("Конструктор отключён");reload()}catch(e:any){toast(e.message)}}return <div><div className="toolbar"><div><h2>Конструктор тарифов</h2><p>Пользователь сам выбирает устройства, трафик и срок. Цена равна базовой цене плюс выбранные пункты. 0 ГБ означает безлимит.</p></div></div><div className="card"><div className="inline"><input placeholder="Название" value={form.name} onChange={e=>setForm({...form,name:e.target.value})}/><input className="small-input" type="number" placeholder="Базовая цена" value={form.base_price} onChange={e=>setForm({...form,base_price:e.target.value})}/><input placeholder="Профиль Remnawave" value={form.remnawave_profile_id} onChange={e=>setForm({...form,remnawave_profile_id:e.target.value})}/><input className="small-input" placeholder="Порядок" value={form.sort_order} onChange={e=>setForm({...form,sort_order:e.target.value})}/></div><label>Описание<textarea value={form.description} onChange={e=>setForm({...form,description:e.target.value})}/></label><label><input type="checkbox" checked={!!form.enabled} onChange={e=>setForm({...form,enabled:e.target.checked})}/> Включён</label>{form.options.map((o:any,i:number)=><div className="inline" key={i}><select value={o.kind} onChange={e=>setOpt(i,{kind:e.target.value})}><option value="devices">Устройства</option><option value="traffic_gb">Трафик, ГБ</option><option value="days">Дни</option></select><input placeholder="Подпись" value={o.label} onChange={e=>setOpt(i,{label:e.target.value})}/><input className="small-input" type="number" placeholder="Значение" value={o.value} onChange={e=>setOpt(i,{value:e.target.value})}/><input className="small-input" type="number" placeholder="Цена" value={o.price} onChange={e=>setOpt(i,{price:e.target.value})}/><button type="button" onClick={()=>setForm({...form,options:form.options.filter((_:any,j:number)=>j!==i)})}>Убрать</button></div>)}<div className="inline"><button type="button" onClick={()=>setForm({...form,options:[...form.options,{kind:"devices",label:"Пункт",value:1,price:"0",enabled:true,sort_order:form.options.length}]})}>+ Пункт</button><button className="primary" onClick={save}>{editing?"Сохранить конструктор":"Создать конструктор"}</button>{editing&&<button type="button" onClick={()=>{setEditing(null);setForm(empty)}}>Отмена</button>}</div></div>{rows.map((row:any)=><div className="card" key={row.id}><h3>{row.name} · {row.base_price} ₽ {row.enabled?"":"(выключен)"}</h3><p>{row.description}</p><ul>{(row.options||[]).map((o:any)=><li key={o.id||`${o.kind}-${o.label}`}>{o.kind}: {o.label} = {o.value} (+{o.price})</li>)}</ul><div className="inline"><button onClick={()=>edit(row)}>Изменить</button><button onClick={()=>disable(row.id)}>Отключить</button></div></div>)}</div>}
function RemnawaveNodes({d,reload}:any){const nodes=d?.nodes||[];return <div><div className="toolbar"><div><h2>Мониторинг Remnawave</h2><p>Статус узлов. Адреса, токены и сырой ответ панели не показываются.</p></div><button className="primary" onClick={reload}>Обновить</button></div><div className="stats"><Stat title="Доступность" value={d?.ok?"Панель отвечает":"Remnawave недоступен"} icon="⌁"/><Stat title="Задержка" value={d?.latency_ms!=null?`${d.latency_ms} мс`:"—"} icon="◷"/><Stat title="Онлайн" value={`${d?.online??0}/${d?.total??0}`} icon="◉"/><Stat title="Офлайн" value={d?.offline??0} icon="!"/></div>{d?.error&&<div className="error">{d.error}</div>}<div className="card"><Table title="Узлы" cols={["Имя","Страна","Статус","Онлайн"]} rows={nodes.map((n:any)=>[n.name,n.country||"—",n.status,n.users_online??"—"])}/>{!nodes.length&&<p>Нет узлов</p>}</div></div>}
