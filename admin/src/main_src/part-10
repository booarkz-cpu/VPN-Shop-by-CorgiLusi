function Admins({d,reload,toast}:any){const[email,setEmail]=useState('');const[pw,setPw]=useState('');const[telegramId,setTelegramId]=useState('');const[role,setRole]=useState('viewer');async function add(){await req('/api/admin/admins',{method:'POST',body:JSON.stringify({email,password:pw,telegram_id:telegramId?Number(telegramId):null,role})});setEmail('');setPw('');setTelegramId('');toast('Администратор создан');reload()}return <div className="card"><h3>Администраторы</h3><p className="muted">Telegram ID используется как привязка администратора. Указывайте числовой ID пользователя Telegram.</p><div className="form-grid"><input placeholder="Email" value={email} onChange={e=>setEmail(e.target.value)}/><input placeholder="Пароль (не менее 12 символов)" type="password" value={pw} onChange={e=>setPw(e.target.value)}/><input placeholder="Telegram ID" inputMode="numeric" value={telegramId} onChange={e=>setTelegramId(e.target.value.replace(/\D/g,''))}/><select value={role} onChange={e=>setRole(e.target.value)}><option value="viewer">Наблюдатель</option><option value="operator">Оператор</option><option value="admin">Администратор</option></select><button className="primary" onClick={add}>Добавить</button></div><Table title="Список администраторов" cols={['ID','Email','Telegram ID','Роль','2FA','Статус','Действия']} rows={(d||[]).map((x:any)=>[x.id,x.email,x.telegram_id||'—',x.role==='admin'?'Администратор':x.role==='operator'?'Оператор':'Наблюдатель',x.mfa_enabled?'ВКЛ':'ВЫКЛ',x.disabled?'ОТКЛЮЧЁН':'АКТИВЕН',x.role!=='admin'&&<button onClick={async()=>{await req(`/api/admin/admins/${x.id}`,{method:'DELETE'});reload()}}>Удалить</button>])}/></div>}

function StagingE2E({d,reload,toast}:any){const[cfg,setCfg]=useState<any>({public_base_url:'',remnawave_url:'',remnawave_token:'',user_bearer_token:'',plan_id:'',providers:['yookassa','platega','rollypay'],yookassa_enabled:true,platega_enabled:true,rollypay_enabled:true,timeout_seconds:1800,staging_confirmed:false,yookassa_api_url:'https://api.yookassa.ru',yookassa_shop_id:'',yookassa_secret_key:'',platega_api_url:'https://app.platega.io',platega_merchant_id:'',platega_secret:'',platega_refund_url:'',platega_refund_status_url:'',rollypay_api_url:'https://rollypay.io',rollypay_api_key:'',rollypay_signing_secret:'',rollypay_refund_url:'',rollypay_refund_status_url:''});useEffect(()=>{if(d?.config)setCfg((x:any)=>({...x,...d.config,remnawave_token:'',user_bearer_token:'',yookassa_secret_key:'',platega_secret:'',rollypay_api_key:'',rollypay_signing_secret:''}))},[d]);useEffect(()=>{if((d?.status||{}).status!=='running')return;const t=setInterval(()=>reload(),4000);return()=>clearInterval(t)},[d,reload]);async function save(){const body={...cfg,plan_id:Number(cfg.plan_id),providers:['yookassa','platega','rollypay'].filter(p=>cfg[p+'_enabled']),staging_confirmed:!!cfg.staging_confirmed};if(!body.staging_confirmed){toast('Подтвердите, что это sandbox-ключи');return}if(!body.remnawave_token && !d?.config?.remnawave_token_configured){toast('Укажите токен Remnawave для staging');return}if(body.providers.length===0){toast('Выберите хотя бы одного провайдера');return}await req('/api/admin/staging-e2e/config',{method:'PUT',body:JSON.stringify(body)});toast('Конфигурация staging E2E сохранена');reload()}async function run(){await req('/api/admin/staging-e2e/run',{method:'POST'});toast('Проверка тестового контура запущен');setTimeout(reload,1000)}const st=d?.status||{};return <div className="grid2"><div className="card"><h3>Настройка боевого staging E2E</h3><p className="muted">Текущий runner проверяет API провайдеров и возврат, но не webhook и выдачу. Он не открывает реальные платежи.</p><p className="muted">Используйте только тестовые/sandbox-реквизиты. Продакшн-реквизиты платёжных систем запрещены и автоматически отклоняются. Пустое поле при повторном сохранении оставляет уже записанный секрет, Shop ID или Merchant ID.</p><label>Публичный HTTPS URL<input value={cfg.public_base_url||''} onChange={e=>setCfg({...cfg,public_base_url:e.target.value})} placeholder="https://staging.example.com"/></label><label>URL Remnawave<input value={cfg.remnawave_url||''} onChange={e=>setCfg({...cfg,remnawave_url:e.target.value})} placeholder="https://panel.example.com"/></label><label>Токен Remnawave<input type="password" value={cfg.remnawave_token||''} onChange={e=>setCfg({...cfg,remnawave_token:e.target.value})} placeholder="Оставьте пустым, чтобы сохранить текущий"/></label><label>Bearer-токен тестового пользователя<input type="password" value={cfg.user_bearer_token||''} onChange={e=>setCfg({...cfg,user_bearer_token:e.target.value})} placeholder="Оставьте пустым, чтобы сохранить текущий"/></label><label>ID тестового тарифа<input type="number" value={cfg.plan_id||''} onChange={e=>setCfg({...cfg,plan_id:e.target.value})}/></label><h4>ЮKassa — sandbox</h4><input value={cfg.yookassa_shop_id||''} onChange={e=>setCfg({...cfg,yookassa_shop_id:e.target.value})} placeholder="ID тестового магазина"/><input type="password" value={cfg.yookassa_secret_key||''} onChange={e=>setCfg({...cfg,yookassa_secret_key:e.target.value})} placeholder="Секретный ключ sandbox"/><h4>Platega — тестовые реквизиты</h4><input value={cfg.platega_merchant_id||''} onChange={e=>setCfg({...cfg,platega_merchant_id:e.target.value})} placeholder="Merchant ID тестового аккаунта"/><input type="password" value={cfg.platega_secret||''} onChange={e=>setCfg({...cfg,platega_secret:e.target.value})} placeholder="Secret тестового аккаунта"/><input value={cfg.platega_refund_url||''} onChange={e=>setCfg({...cfg,platega_refund_url:e.target.value})} placeholder="HTTPS URL возврата Platega"/><input value={cfg.platega_refund_status_url||''} onChange={e=>setCfg({...cfg,platega_refund_status_url:e.target.value})} placeholder="HTTPS URL статуса возврата Platega"/><h4>RollyPay — sandbox</h4><input type="password" value={cfg.rollypay_api_key||''} onChange={e=>setCfg({...cfg,rollypay_api_key:e.target.value})} placeholder="API-ключ sandbox"/><input type="password" value={cfg.rollypay_signing_secret||''} onChange={e=>setCfg({...cfg,rollypay_signing_secret:e.target.value})} placeholder="Signing secret sandbox"/><input value={cfg.rollypay_refund_url||''} onChange={e=>setCfg({...cfg,rollypay_refund_url:e.target.value})} placeholder="HTTPS URL возврата RollyPay"/><input value={cfg.rollypay_refund_status_url||''} onChange={e=>setCfg({...cfg,rollypay_refund_status_url:e.target.value})} placeholder="HTTPS URL статуса возврата RollyPay"/><div className="inline"><label><input type="checkbox" checked={!!cfg.yookassa_enabled} onChange={e=>setCfg({...cfg,yookassa_enabled:e.target.checked})}/> ЮKassa</label><label><input type="checkbox" checked={!!cfg.platega_enabled} onChange={e=>setCfg({...cfg,platega_enabled:e.target.checked})}/> Platega</label><label><input type="checkbox" checked={!!cfg.rollypay_enabled} onChange={e=>setCfg({...cfg,rollypay_enabled:e.target.checked})}/> RollyPay</label></div><label className="inline"><input type="checkbox" checked={!!cfg.staging_confirmed} onChange={e=>setCfg({...cfg,staging_confirmed:e.target.checked})}/> Подтверждаю sandbox-ключи</label><button className="primary" onClick={save}>Сохранить безопасную конфигурацию</button></div><div className="card"><h3>Запуск и результат</h3><Row k="Статус" v={ru(st.status||'не запускался')}/><Row k="Начат" v={st.started_at||'—'}/><Row k="Завершён" v={st.finished_at||'—'}/>{st.output&&<pre className="log-output">{st.output}</pre>}<button className="primary" disabled={st.status==='running'} onClick={run}>{st.status==='running'?'Выполняется…':'Запустить staging E2E'}</button><p className="muted">Платёж создаётся только через отдельный staging-контур с зашифрованными тестовыми credentials. Продакшн credentials не используются.</p></div></div>}
