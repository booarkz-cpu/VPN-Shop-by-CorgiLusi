function Plans({d,reload}:any){const[n,setN]=useState('');const[p,setP]=useState('10');async function add(){if(!n)return;await req('/api/admin/plans',{method:'POST',body:JSON.stringify({name:n,price:Number(p),duration_days:30,enabled:true})});setN('');reload()}return <><div className="toolbar"><div><h2>Тарифы</h2></div><div className="inline"><input placeholder="Название" value={n} onChange={e=>setN(e.target.value)}/><input className="small-input" type="number" value={p} onChange={e=>setP(e.target.value)}/><button className="primary" onClick={add}>+ Добавить</button></div></div><div className="plan-grid">{(d||[]).map((x:any)=><div className="plan card" key={x.id}><span className="badge">#{x.id}</span><h3>{x.name}</h3><div className="price">{x.price} <small>₽</small></div><p>{x.duration_days} дней</p><button onClick={async()=>{await req(`/api/admin/plans/${x.id}`,{method:'DELETE'});reload()}}>Удалить</button></div>)}</div></>}
function ContentEditor({d,reload,toast}:any){
 const[s,setS]=useState<any>({});const[m,setM]=useState<any[]>([]);const[f,setF]=useState<any[]>([]);const[mini,setMini]=useState<any>({});const[menuNew,setMenuNew]=useState({title:'',action:'',item_type:'webapp'});const[fieldNew,setFieldNew]=useState({key:'',label:'',field_type:'text',value:''});const[file,setFile]=useState<File|null>(null);const[botFile,setBotFile]=useState<File|null>(null);const[bgFile,setBgFile]=useState<File|null>(null);
 useEffect(()=>{setS(d?.settings||{});setM(d?.menu||[]);setF(d?.fields||[]);setMini({title:d?.settings?.miniapp_title||'',subtitle:d?.settings?.miniapp_subtitle||'',background_color:d?.settings?.miniapp_background_color||'#f5f7fb',instructions:d?.settings?.miniapp_instructions||'',buttons:d?.settings?.miniapp_buttons||[]})},[d]);
 async function setting(k:string){await req(`/api/admin/settings/${k}`,{method:'PUT',body:JSON.stringify({value:s[k]||''})});toast('Сохранено');reload()}
 async function saveMini(){await req('/api/admin/miniapp/config',{method:'PUT',body:JSON.stringify(mini)});toast('Mini App сохранён');reload()}
 async function uploadBg(){if(!bgFile)return;const fd=new FormData();fd.append('file',bgFile);await req('/api/admin/miniapp/background',{method:'POST',body:fd});setBgFile(null);toast('Фон загружен');reload()}
 async function addMenu(){if(!menuNew.title||!menuNew.action)return;await req('/api/admin/menu',{method:'POST',body:JSON.stringify(menuNew)});setMenuNew({title:'',action:'',item_type:'webapp'});reload()}
 async function addField(){if(!fieldNew.key||!fieldNew.label)return;await req('/api/admin/fields',{method:'POST',body:JSON.stringify({...fieldNew,enabled:true,sort_order:f.length})});setFieldNew({key:'',label:'',field_type:'text',value:''});reload()}
 async function uploadBotImage(){if(!botFile)return;const fd=new FormData();fd.append('file',botFile);await req('/api/admin/bot/start-image',{method:'POST',body:fd});setBotFile(null);toast('Изображение приветствия бота сохранено');reload()}async function uploadImage(){if(!file)return;const fd=new FormData();fd.append('title',file.name);fd.append('file',file);await req('/api/admin/images',{method:'POST',body:fd});setFile(null);toast('Изображение загружено');reload()}
 return <div className="grid2"><div className="card"><h3>Брендинг бота</h3><label>Название бота<input value={s.bot_name||''} onChange={e=>setS({...s,bot_name:e.target.value})}/></label><button className="primary" onClick={()=>setting('bot_name')}>Сохранить</button><label>Название приложения<input value={s.app_name||''} onChange={e=>setS({...s,app_name:e.target.value})}/></label><button onClick={()=>setting('app_name')}>Сохранить</button><h3>Изображение /start</h3><input type="file" accept="image/png,image/jpeg,image/webp" onChange={e=>setBotFile(e.target.files?.[0]||null)}/><button onClick={uploadBotImage}>Установить изображение</button>{s.bot_start_image&&<><img src={API+s.bot_start_image} style={{width:160,maxHeight:160,objectFit:'cover',borderRadius:12}}/><button onClick={async()=>{await req('/api/admin/bot/start-image',{method:'DELETE'});reload()}}>Удалить изображение</button></>}<h3>Меню Telegram</h3>{m.map((x:any)=><div className="inline" key={x.id}><input value={x.title} onChange={e=>setM(m.map((q:any)=>q.id===x.id?{...q,title:e.target.value}:q))}/><button onClick={async()=>{await req(`/api/admin/menu/${x.id}`,{method:'PUT',body:JSON.stringify(x)});reload()}}>Сохранить</button><button onClick={async()=>{await req(`/api/admin/menu/${x.id}`,{method:'DELETE'});reload()}}>×</button></div>)}<div className="form-grid"><input placeholder="Новая кнопка" value={menuNew.title} onChange={e=>setMenuNew({...menuNew,title:e.target.value})}/><input placeholder="URL / действие" value={menuNew.action} onChange={e=>setMenuNew({...menuNew,action:e.target.value})}/><select value={menuNew.item_type} onChange={e=>setMenuNew({...menuNew,item_type:e.target.value})}><option value="webapp">Mini App</option><option value="url">URL</option><option value="field">Поле</option></select><button onClick={addMenu}>Добавить</button></div><h3>Изображения меню</h3><input type="file" accept="image/png,image/jpeg,image/webp,image/gif" onChange={e=>setFile(e.target.files?.[0]||null)}/><button onClick={uploadImage}>Загрузить</button><div>{(d?.images||[]).map((x:any)=><div className="inline" key={x.id}><img src={API+x.url} style={{width:64,height:64,objectFit:'cover'}}/><span>{x.title}</span><button onClick={async()=>{await req(`/api/admin/images/${x.id}`,{method:'DELETE'});reload()}}>×</button></div>)}</div></div>
