# Local test profile. scripts/test-up.sh copies this to .env.test and
# replaces the three CHANGE_ME values with random secrets.
# APP_ENV must stay development, test, or staging. production refuses PAYMENTS_SANDBOX.

APP_SECRET=CHANGE_ME_APP_SECRET_AT_LEAST_32_CHARS
APP_SECRET_PREVIOUS=
APP_ENV=development
DEFAULT_LANGUAGE=ru
MAINTENANCE_MODE=false
TZ=Europe/Moscow
LOG_LEVEL=INFO

DB_USER=vpnshop
DB_NAME=vpnshop
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_USER=vpnshop
POSTGRES_DB=vpnshop
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://vpnshop:CHANGE_ME_DB_PASSWORD@db:5432/vpnshop

REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

BOT_TOKEN=
BOT_USERNAME=
ADMIN_TELEGRAM_ID=0

REMNAWAVE_URL=
REMNAWAVE_TOKEN=

ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_CORS_ORIGINS=http://127.0.0.1:18081,http://localhost:18081,http://127.0.0.1:18082,http://localhost:18082,http://127.0.0.1:18083,http://localhost:18083
PUBLIC_BASE_URL=http://127.0.0.1:18080
MINI_APP_URL=http://127.0.0.1:18083
CABINET_URL=http://127.0.0.1:18082
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

ADMIN_DOMAIN=localhost
APP_DOMAIN=localhost
API_DOMAIN=localhost
MINIAPP_DOMAIN=localhost
CABINET_DOMAIN=localhost
BOT_DOMAIN=localhost
WEBHOOK_DOMAIN=localhost
PANEL_DOMAIN=localhost

DEFAULT_CURRENCY=RUB
PRICE_1=199
PRICE_3=499
PRICE_6=899
PRICE_12=1499

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_IP_ALLOWLIST=
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
ROLLYPAY_TEST_MODE=false
CRYPTOBOT_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

WEBHOOK_BASE_URL=http://127.0.0.1:18080
PAYMENTS_SANDBOX=true
TRIAL_MAX_DAYS=3
AUTO_RENEW_ENABLED=false
REQUIRED_TELEGRAM_CHANNEL=

METRICS_ENABLED=false
